{
  "name": "ai-hub-webpage",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:pdf",
    "build:pdf": "node scripts/generate-pdfs.mjs",
    "check": "astro check",
    "check:design": "node scripts/check-design-system.mjs",
    "check:links": "node scripts/check-case-links.mjs",
    "check:layout": "node scripts/check-layout-snapshots.mjs",
    "snapshot:update": "node scripts/check-layout-snapshots.mjs --update",
    "verify": "npm run check && npm run check:design && npm run check:links && npm run build && npm run check:layout",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^4.16.13",
    "@astrojs/tailwind": "^5.1.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.3"
  }
}
