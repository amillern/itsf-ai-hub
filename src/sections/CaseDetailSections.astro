---
import FigmaStatusBadge from '../components/figma/FigmaStatusBadge.astro';
import type { CaseStudy } from '../data/cases';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  caseStudy: CaseStudy;
  lang?: Lang;
}

const { caseStudy, lang = 'uk' } = Astro.props;
const t = useTranslations(lang);
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 sm:space-y-12">
  
  <!-- Navigation Back Button -->
  <div>
    <a 
      href={lang === 'en' ? '/en/catalog/' : '/catalog/'}
      class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-text-muted hover:text-brand-red transition-colors font-roboto group"
    >
      <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>{t('case.back')}</span>
    </a>
  </div>

  <!-- Header & Meta Section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-start">
    
    <!-- Left Column: Titles & Badges -->
    <div class="lg:col-span-5 space-y-4 sm:space-y-6">
      <div class="flex items-center gap-3">
        <FigmaStatusBadge variant="business">
          {caseStudy.badge[lang]}
        </FigmaStatusBadge>
      </div>

      <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-red font-fixel">
        {caseStudy.title[lang]}
      </p>

      <h1 class="text-2xl sm:text-4xl font-fixel font-black text-text-main leading-tight tracking-tight">
        {caseStudy.subtitle[lang]}
      </h1>

      <!-- Section: Business Task -->
      <div class="space-y-3 pt-2">
        <h3 class="text-base sm:text-lg font-fixel font-bold text-brand-red-dark">
          {t('case.challenge')}:
        </h3>

        <div class="flex flex-wrap gap-2">
          {caseStudy.tags[lang].map(tag => (
            <span class="px-3.5 sm:px-4 py-1.5 sm:py-2 bg-white border border-gray-300 text-text-main text-[11px] sm:text-xs font-semibold rounded-full shadow-sm font-roboto">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Section: Application Scope -->
      <div class="space-y-3 pt-2">
        <h3 class="text-base sm:text-lg font-fixel font-bold text-brand-red-dark">
          {t('case.scope')}:
        </h3>

        <p class="text-sm text-text-main font-semibold leading-relaxed font-roboto">
          {caseStudy.scope[lang]}
        </p>
      </div>

      <!-- Complexity Comparison Box -->
      <div class="p-4 sm:p-5 rounded-2xl bg-white border border-gray-100 shadow-sm space-y-3">
        <h4 class="text-xs font-bold text-text-muted uppercase tracking-wider font-fixel">Implementation Complexity</h4>
        <div class="grid grid-cols-2 gap-3 text-xs sm:text-sm font-roboto">
          <div class="p-3 rounded-xl bg-gray-50 border border-gray-200">
            <span class="text-gray-500 block text-[11px]">Without AI</span>
            <span class="font-bold text-rose-600">{caseStudy.difficultyWithout[lang]}</span>
          </div>
          <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
            <span class="text-emerald-700 block text-[11px]">With AI</span>
            <span class="font-bold text-emerald-800">{caseStudy.difficultyWith[lang]}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Banner & Detailed Solution Cards -->
    <div class="lg:col-span-7 space-y-6 sm:space-y-8">
      
      <!-- Banner Image -->
      <div class="rounded-[24px] sm:rounded-[32px] overflow-hidden border border-gray-100 shadow-card bg-surface-variant relative aspect-[16/9] group">
        <img 
          src={caseStudy.bannerImage} 
          alt={caseStudy.title[lang]}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
        />
      </div>

      <!-- Top Card: Overview -->
      <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-8 border border-gray-100 shadow-card space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-brand-red"></div>
          <h3 class="text-lg sm:text-xl font-fixel font-bold text-text-main">
            Solution Overview
          </h3>
        </div>

        <p class="text-sm sm:text-base text-text-muted leading-relaxed font-roboto">
          {caseStudy.overview[lang]}
        </p>
      </div>

      <!-- Grid Cards: Challenge & Solution -->
      <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-8 border border-gray-100 shadow-card grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
        
        <!-- Challenge -->
        <div class="space-y-3">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
            {t('case.challenge')}:
          </h4>
          <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
            {caseStudy.challenge[lang]}
          </p>
        </div>

        <!-- Solution -->
        <div class="space-y-3">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
            {t('case.solution')}:
          </h4>
          <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
            {caseStudy.solution[lang]}
          </p>
        </div>

      </div>

    </div>

  </div>

  <!-- Key Features Section -->
  <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 border border-gray-100 shadow-card space-y-6">
    <h3 class="text-xl sm:text-2xl font-fixel font-extrabold text-text-main">
      {t('case.features')}
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {caseStudy.keyFeatures.map((feat) => (
        <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100 space-y-2">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <h4 class="font-fixel font-bold text-sm sm:text-base text-text-main">
              {feat.title[lang]}
            </h4>
          </div>
          <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto pl-6">
            {feat.desc[lang]}
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Metrics & Tech Stack Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8">
    
    <!-- Left Column: Metrics -->
    <div class="lg:col-span-7 bg-gradient-to-br from-[#0D0422] to-[#1A0B38] rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 text-white space-y-6 shadow-xl">
      <h3 class="text-xl sm:text-2xl font-fixel font-extrabold text-white">
        {t('case.metrics')}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {caseStudy.metrics.map(m => (
          <div class="p-4 rounded-2xl bg-white/10 border border-white/10 space-y-1">
            <div class="text-2xl sm:text-3xl font-fixel font-black text-brand-red-soft">
              {m.value[lang]}
            </div>
            <div class="text-xs text-gray-300 font-roboto">
              {m.label[lang]}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Tech Stack -->
    <div class="lg:col-span-5 bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 border border-gray-100 shadow-card space-y-6">
      <h3 class="text-xl sm:text-2xl font-fixel font-extrabold text-text-main">
        {t('case.tech')}
      </h3>

      <div class="flex flex-wrap gap-2">
        {caseStudy.techStack.map(tech => (
          <span class="px-4 py-2 bg-gray-100 text-text-main font-fixel font-semibold text-xs sm:text-sm rounded-xl">
            {tech}
          </span>
        ))}
      </div>
    </div>

  </div>

  <!-- CTA Banner -->
  <div class="bg-gradient-to-r from-brand-red to-brand-red-dark rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="space-y-2 text-center sm:text-left">
      <h3 class="text-xl sm:text-3xl font-fixel font-extrabold">
        {t('case.cta.title')}
      </h3>
      <p class="text-white/80 text-xs sm:text-sm font-roboto">
        Connect with our AI engineers to discuss your implementation roadmap.
      </p>
    </div>

    <a
      href={lang === 'en' ? '/en/contacts/' : '/contacts/'}
      class="px-8 py-4 bg-white text-brand-red font-fixel font-bold text-sm sm:text-base rounded-full hover:bg-gray-100 transition-colors shadow-lg whitespace-nowrap"
    >
      {t('case.cta.btn')}
    </a>
  </div>

</div>
