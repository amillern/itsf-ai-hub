---
import FigmaStatusBadge from '../components/figma/FigmaStatusBadge.astro';
import { caseStudies } from '../data/cases';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'uk' } = Astro.props;
const t = useTranslations(lang);
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 sm:space-y-12">
  
  <div class="max-w-3xl space-y-4">
    <h1 class="text-3xl sm:text-5xl font-fixel font-black tracking-tight text-text-main leading-tight">
      {t('cases.grid.title')}
    </h1>
    <p class="text-text-muted text-base sm:text-lg leading-relaxed font-roboto">
      {t('cases.grid.sub')}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
    {caseStudies.map((item) => (
      <a 
        href={lang === 'en' ? `/en/cases/${item.slug}/` : `/cases/${item.slug}/`}
        class="group bg-white rounded-3xl p-6 border border-gray-100 shadow-sm flex flex-col justify-between space-y-5 hover:-translate-y-2 hover:shadow-xl hover:border-brand-red/30 transition-all duration-300 cursor-pointer"
      >
        <div class="space-y-4">
          <div class="rounded-2xl overflow-hidden bg-purple-900/10 h-48 border border-gray-100">
            <img 
              src={item.bannerImage} 
              alt={item.title[lang]} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <div class="flex items-center justify-between">
            <FigmaStatusBadge variant="business">
              {item.badge[lang]}
            </FigmaStatusBadge>
          </div>

          <h3 class="text-xl font-fixel font-bold text-text-main group-hover:text-brand-red transition-colors leading-snug">
            {item.title[lang]}
          </h3>

          <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto line-clamp-3">
            {item.overview[lang]}
          </p>
        </div>

        <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
          <div class="flex flex-wrap gap-1.5">
            {item.tags[lang].map(tag => (
              <span class="text-[11px] font-medium text-gray-600 bg-gray-100 px-2.5 py-1 rounded-lg">
                #{tag}
              </span>
            ))}
          </div>

          <span class="text-sm font-bold text-brand-red group-hover:translate-x-1 transition-transform flex items-center gap-1">
            <span>→</span>
          </span>
        </div>
      </a>
    ))}
  </div>

</div>
