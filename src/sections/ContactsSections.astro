---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'uk' } = Astro.props;
const t = useTranslations(lang);
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 sm:space-y-12">
  
  <div class="max-w-3xl space-y-4">
    <h1 class="text-3xl sm:text-5xl font-fixel font-black tracking-tight text-text-main leading-tight">
      {t('contacts.title')}
    </h1>

    <p class="text-text-muted text-base sm:text-lg leading-relaxed font-roboto">
      {t('contacts.sub')}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-start">
    
    <!-- Contact Info Box -->
    <div class="lg:col-span-5 bg-gradient-to-br from-[#0D0422] via-[#14082B] to-[#1A0B38] text-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 space-y-8 shadow-xl relative overflow-hidden border border-white/10">
      
      <div class="space-y-3 relative z-10">
        <h2 class="text-2xl font-fixel font-extrabold text-white">
          {t('contacts.info.title')}
        </h2>
        <p class="text-gray-300 text-xs sm:text-sm leading-relaxed font-roboto">
          Direct communication line with IT SmartFlex AI Unit architects.
        </p>
      </div>

      <div class="space-y-6 relative z-10 font-roboto">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-brand-red/20 text-brand-red flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <span class="text-xs text-gray-400 block">{t('contacts.info.email')}</span>
            <a href="mailto:contact_us@itsmartflex.com" class="text-sm font-semibold hover:text-brand-red transition-colors">
              contact_us@itsmartflex.com
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-brand-red/20 text-brand-red flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <span class="text-xs text-gray-400 block">{t('contacts.info.location')}</span>
            <span class="text-sm font-semibold">{t('contacts.info.address')}</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Contact Form Card -->
    <div class="lg:col-span-7 bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 border border-gray-100 shadow-card">
      
      <form id="contacts-form" class="space-y-5">
        
        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <input type="text" name="website_url_hp" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label for="firstName" class="text-xs font-bold text-text-main font-fixel">{t('form.firstName')} *</label>
            <input 
              type="text" 
              id="firstName" 
              name="firstName" 
              required
              placeholder={t('form.firstName')}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="lastName" class="text-xs font-bold text-text-main font-fixel">{t('form.lastName')} *</label>
            <input 
              type="text" 
              id="lastName" 
              name="lastName" 
              required
              placeholder={t('form.lastName')}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label for="email" class="text-xs font-bold text-text-main font-fixel">{t('form.email')} *</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              placeholder="name@company.com"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="phone" class="text-xs font-bold text-text-main font-fixel">{t('form.phone')}</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              placeholder="+380..."
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="space-y-1.5">
            <label for="company" class="text-xs font-bold text-text-main font-fixel">{t('form.company')}</label>
            <input 
              type="text" 
              id="company" 
              name="company" 
              placeholder={t('form.company')}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors"
            />
          </div>

          <div class="space-y-1.5">
            <label for="position" class="text-xs font-bold text-text-main font-fixel">{t('form.position')}</label>
            <input 
              type="text" 
              id="position" 
              name="position" 
              placeholder={t('form.position')}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="message" class="text-xs font-bold text-text-main font-fixel">{t('form.message')} *</label>
          <textarea 
            id="message" 
            name="message" 
            rows="4" 
            required
            placeholder={t('form.message')}
            class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-sm text-text-main focus:outline-none focus:border-brand-red focus:bg-white transition-colors resize-none"
          ></textarea>
        </div>

        <!-- Alert Error Message -->
        <div id="form-error-msg" class="hidden role-alert p-4 bg-red-50 border border-red-200 rounded-xl text-xs text-red-700 space-y-1">
          <p class="font-bold">{t('form.error')}</p>
        </div>

        <!-- Alert Success Message -->
        <div id="form-success-msg" class="hidden role-alert p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-800 space-y-1">
          <p class="font-bold">{t('form.success')}</p>
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-4 bg-brand-red hover:bg-brand-red-dark text-white font-fixel font-bold text-base rounded-xl transition-all duration-300 shadow-md hover:shadow-lg cursor-pointer"
        >
          <span id="submit-text">{t('form.submit')}</span>
        </button>

      </form>

    </div>

  </div>

</div>

<script>
  const form = document.getElementById('contacts-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text');
  const errorMsg = document.getElementById('form-error-msg');
  const successMsg = document.getElementById('form-success-msg');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const honeypot = formData.get('website_url_hp');
      
      if (honeypot) {
        return; // Silent reject bot spam
      }

      if (submitBtn && submitText) {
        submitBtn.disabled = true;
        submitText.textContent = "Sending...";
      }

      if (errorMsg) errorMsg.classList.add('hidden');
      if (successMsg) successMsg.classList.add('hidden');

      const payload = {
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        company: formData.get('company'),
        position: formData.get('position'),
        message: formData.get('message'),
        submittedAt: new Date().toISOString()
      };

      const webhookUrl = "https://script.google.com/macros/s/AKfycbxL0bx2s0YynFC-cXgHNFEJjBcFZOXjkUhES7FFiA5p1u8AsdHeQ2UtJmPRZPlkW18/exec";

      fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(res => {
        onSuccess();
      })
      .catch(err => {
        onSuccess();
      });

      function onSuccess() {
        if (submitBtn && submitText) {
          submitBtn.disabled = false;
          submitText.textContent = "Submit";
        }
        if (successMsg) {
          successMsg.classList.remove('hidden');
          successMsg.classList.add('flex');
        }
        
        if (typeof (window as any).sendAmplitudeEvent === 'function') {
          (window as any).sendAmplitudeEvent('submit_contact_form', {
            form_id: 'contacts_main',
            has_message: true
          });
        }

        // @ts-ignore
        if (typeof window.gtag === 'function') {
          // @ts-ignore
          window.gtag('event', 'generate_lead', {
            form_id: 'contacts_main'
          });
        }

        form.reset();
      }
    });
  }
</script>
