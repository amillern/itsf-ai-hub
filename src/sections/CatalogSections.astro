---
import SolutionCard from '../components/SolutionCard.astro';
import { caseStudies } from '../data/cases';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'uk' } = Astro.props;
const t = useTranslations(lang);

// Extract all unique tags
const allTags = Array.from(new Set(caseStudies.flatMap(item => item.tags[lang]))).sort();
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8 sm:space-y-12">
  
  <!-- Page Header -->
  <div class="max-w-3xl space-y-4">
    <h1 class="text-3xl sm:text-5xl font-fixel font-black tracking-tight text-text-main leading-tight">
      {t('catalog.title')}
    </h1>

    <p class="text-text-muted text-base sm:text-lg leading-relaxed font-roboto">
      {t('catalog.sub')}
    </p>
  </div>

  <!-- Filters Toolbar -->
  <div class="bg-white rounded-2xl p-4 sm:p-6 border border-gray-100 shadow-sm space-y-4">
    
    <!-- Row 1: Type Filter Tabs & Popover Toggle -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      
      <!-- Type Filter Tabs -->
      <div class="flex items-center gap-1.5 p-1.5 bg-gray-100 rounded-xl overflow-x-auto" id="type-tabs-container">
        <button 
          type="button"
          class="type-tab-btn px-4 py-2 text-xs sm:text-sm font-fixel font-bold rounded-lg transition-all cursor-pointer bg-brand-red-soft text-text-main shadow-sm active"
          data-type-tab="all"
        >
          {t('catalog.tab.all')}
        </button>
        <button 
          type="button"
          class="type-tab-btn px-4 py-2 text-xs sm:text-sm font-fixel font-bold rounded-lg transition-all cursor-pointer text-text-muted hover:text-text-main"
          data-type-tab="business"
        >
          {t('catalog.tab.business')}
        </button>
        <button 
          type="button"
          class="type-tab-btn px-4 py-2 text-xs sm:text-sm font-fixel font-bold rounded-lg transition-all cursor-pointer text-text-muted hover:text-text-main"
          data-type-tab="usecase"
        >
          {t('catalog.tab.usecase')}
        </button>
      </div>

      <!-- Directions Popover Trigger -->
      <div class="relative">
        <button 
          type="button"
          id="directions-filter-toggle"
          aria-expanded="false"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-text-main text-xs sm:text-sm font-semibold font-fixel rounded-xl transition-colors cursor-pointer w-full md:w-auto justify-between md:justify-start"
        >
          <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <span>{t('catalog.filter.btn')}</span>
          <svg id="filter-chevron" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Popover -->
        <div 
          id="directions-popover"
          class="hidden absolute right-0 mt-2 w-full md:w-80 bg-white rounded-2xl p-4 shadow-xl border border-gray-100 z-50 space-y-3 animate-fade-in"
        >
          <div class="flex items-center justify-between border-b border-gray-100 pb-2">
            <span class="text-xs font-bold font-fixel text-text-main">{t('catalog.filter.btn')}</span>
            <button type="button" id="clear-filters-btn" class="text-[11px] text-brand-red hover:underline font-semibold cursor-pointer">
              {t('catalog.filter.reset')}
            </button>
          </div>

          <div class="max-h-60 overflow-y-auto space-y-2 pr-1 custom-scrollbar">
            {allTags.map(tag => (
              <label class="flex items-center gap-2.5 text-xs text-text-main hover:text-brand-red cursor-pointer p-1 rounded hover:bg-gray-50 font-roboto">
                <input 
                  type="checkbox" 
                  value={tag} 
                  class="filter-checkbox rounded text-brand-red focus:ring-brand-red w-4 h-4 border-gray-300"
                />
                <span>#{tag}</span>
              </label>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Active Tags Chips -->
    <div id="active-chips-container" class="flex flex-wrap items-center gap-2 empty:hidden"></div>

  </div>

  <!-- Catalog Grid -->
  <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
    {caseStudies.map((item) => (
      <div 
        class="catalog-item-card" 
        data-type={item.type} 
        data-tags={item.tags[lang].join('|||')}
      >
        <SolutionCard caseStudy={item} lang={lang} />
      </div>
    ))}
  </div>

  <!-- Empty State -->
  <div id="empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-gray-100 p-8 space-y-4">
    <div class="w-16 h-16 bg-gray-100 text-gray-400 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
      ?
    </div>
    <h3 class="text-xl font-fixel font-bold text-text-main">{t('catalog.empty.title')}</h3>
    <p class="text-text-muted text-sm max-w-md mx-auto font-roboto">
      {t('catalog.empty.sub')}
    </p>
    <button 
      type="button" 
      id="reset-empty-btn"
      class="px-6 py-2.5 bg-brand-red text-white font-fixel font-semibold text-sm rounded-full hover:bg-brand-red-dark transition-colors"
    >
      {t('catalog.filter.reset')}
    </button>
  </div>

</div>

<script>
  let activeType = 'all';
  let selectedTags: string[] = [];

  const tabBtns = document.querySelectorAll('.type-tab-btn');
  const toggleBtn = document.getElementById('directions-filter-toggle');
  const popover = document.getElementById('directions-popover');
  const chevron = document.getElementById('filter-chevron');
  const clearBtn = document.getElementById('clear-filters-btn');
  const resetBtn = document.getElementById('reset-empty-btn');
  const chipsContainer = document.getElementById('active-chips-container');
  const cardsGrid = document.getElementById('catalog-grid');
  const emptyState = document.getElementById('empty-state');
  const checkboxes = document.querySelectorAll('.filter-checkbox');
  const cardElements = document.querySelectorAll('.catalog-item-card');

  function togglePopover(show?: boolean) {
    if (!popover || !toggleBtn) return;
    const isHidden = show !== undefined ? !show : !popover.classList.contains('hidden');
    if (isHidden) {
      popover.classList.add('hidden');
      chevron?.classList.remove('rotate-180');
      toggleBtn.setAttribute('aria-expanded', 'false');
    } else {
      popover.classList.remove('hidden');
      chevron?.classList.add('rotate-180');
      toggleBtn.setAttribute('aria-expanded', 'true');
    }
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    togglePopover();
  });

  document.addEventListener('click', (e) => {
    if (popover && !popover.contains(e.target as Node) && !toggleBtn?.contains(e.target as Node)) {
      togglePopover(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      togglePopover(false);
    }
  });

  function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const urlType = params.get('type');
    const urlTag = params.get('tag');

    if (urlType && ['all', 'business', 'usecase'].includes(urlType)) {
      activeType = urlType;
      tabBtns.forEach(t => {
        const isMatch = t.getAttribute('data-type-tab') === activeType;
        if (isMatch) {
          t.classList.add('active', 'bg-brand-red-soft', 'text-text-main', 'shadow-sm');
          t.classList.remove('text-text-muted');
        } else {
          t.classList.remove('active', 'bg-brand-red-soft', 'text-text-main', 'shadow-sm');
          t.classList.add('text-text-muted');
        }
      });
    }

    if (urlTag) {
      const tags = urlTag.split(',');
      checkboxes.forEach(cb => {
        const input = cb as HTMLInputElement;
        if (tags.includes(input.value)) {
          input.checked = true;
        }
      });
      updateSelectedTags();
    }

    applyFilters();
  }

  function syncUrl() {
    const url = new URL(window.location.href);
    if (activeType !== 'all') {
      url.searchParams.set('type', activeType);
    } else {
      url.searchParams.delete('type');
    }

    if (selectedTags.length > 0) {
      url.searchParams.set('tag', selectedTags.join(','));
    } else {
      url.searchParams.delete('tag');
    }

    window.history.replaceState({}, '', url.toString());
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      activeType = target.getAttribute('data-type-tab') || 'all';

      tabBtns.forEach(t => {
        t.classList.remove('active', 'bg-brand-red-soft', 'text-text-main', 'shadow-sm');
        t.classList.add('text-text-muted');
      });

      target.classList.add('active', 'bg-brand-red-soft', 'text-text-main', 'shadow-sm');
      target.classList.remove('text-text-muted');

      syncUrl();
      applyFilters();
    });
  });

  checkboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      updateSelectedTags();
      syncUrl();
      applyFilters();
    });
  });

  function updateSelectedTags() {
    selectedTags = [];
    checkboxes.forEach(cb => {
      const input = cb as HTMLInputElement;
      if (input.checked) {
        selectedTags.push(input.value);
      }
    });
    renderChips();
  }

  function renderChips() {
    if (!chipsContainer) return;
    chipsContainer.innerHTML = '';

    selectedTags.forEach(tag => {
      const chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1 px-3 py-1 bg-gray-200 text-text-main text-xs font-semibold rounded-full font-roboto transition-all';
      chip.innerHTML = `
        <span>${tag}</span>
        <button type="button" class="remove-chip-btn hover:text-brand-red font-bold text-sm ml-0.5" data-tag="${tag}">×</button>
      `;
      chipsContainer.appendChild(chip);
    });

    document.querySelectorAll('.remove-chip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const tag = (e.currentTarget as HTMLElement).getAttribute('data-tag');
        if (tag) {
          checkboxes.forEach(cb => {
            const input = cb as HTMLInputElement;
            if (input.value === tag) input.checked = false;
          });
          updateSelectedTags();
          syncUrl();
          applyFilters();
        }
      });
    });
  }

  clearBtn?.addEventListener('click', resetAll);
  resetBtn?.addEventListener('click', resetAll);

  function resetAll() {
    selectedTags = [];
    checkboxes.forEach(cb => { (cb as HTMLInputElement).checked = false; });
    updateSelectedTags();
    syncUrl();
    applyFilters();
  }

  function applyFilters() {
    let visibleCount = 0;

    cardElements.forEach(card => {
      const itemType = card.getAttribute('data-type') || '';
      const itemTagsString = card.getAttribute('data-tags') || '';
      const itemTags = itemTagsString.split('|||');

      const matchesType = (activeType === 'all') || (itemType === activeType);
      
      let matchesTags = true;
      if (selectedTags.length > 0) {
        matchesTags = selectedTags.every(st => itemTags.includes(st));
      }

      if (matchesType && matchesTags) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCount === 0) {
      emptyState?.classList.remove('hidden');
      cardsGrid?.classList.add('hidden');
    } else {
      emptyState?.classList.add('hidden');
      cardsGrid?.classList.remove('hidden');
    }
  }

  initFromUrl();
</script>
