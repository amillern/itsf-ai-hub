---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "AI Hub - Головна | IT SmartFlex",
  description = "Практичні приклади, кейси та сценарії застосування штучного інтелекту на основі досвіду IT SmartFlex.",
  image = "/assets/og-cover.png",
  type = "website"
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://ai.itsmartflex.com').replace(/\/$/, '');
const isProd = import.meta.env.PUBLIC_ENV === 'prod' || import.meta.env.PUBLIC_ENV === 'production';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteUrl).href;
const ogImageURL = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const isJpeg = ogImageURL.endsWith('.jpg') || ogImageURL.endsWith('.jpeg');
const mimeType = isJpeg ? 'image/jpeg' : (ogImageURL.endsWith('.png') ? 'image/png' : 'image/jpeg');
---

<!DOCTYPE html>
<html lang="uk" prefix="og: http://ogp.me/ns#" class="scroll-smooth overflow-x-hidden w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    
    <!-- Clean Uncropped Favicon Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO & Canonical Metadata -->
    {isProd ? <meta name="robots" content="index, follow" /> : <meta name="robots" content="index, follow, noarchive" />}
    <meta name="google-site-verification" content="AI4lwYgK0_677777wFkDAzBBQHgdjSjrpT24xMg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / LinkedIn / Slack / iMessage / Telegram -->
    <meta property="og:site_name" content="IT SmartFlex AI Hub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={mimeType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="uk_UA" />

    <!-- Twitter / LinkedIn Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Analytics (gtag.js) with GDPR Consent Mode v2 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7HGQSSGHRB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // Set default GDPR Consent Mode v2 to 'denied'
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      // Restore consent if user previously granted
      try {
        if (localStorage.getItem('ai_hub_cookie_consent') === 'granted') {
          gtag('consent', 'update', {
            'analytics_storage': 'granted'
          });
        }
      } catch (e) {}

      gtag('config', 'G-7HGQSSGHRB', {
        'anonymize_ip': true,
        'send_page_view': true
      });
    </script>

    <!-- Google Fonts: Inter & Roboto -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Amplitude SDK (Loaded only if consent is granted) -->
    <script is:inline defer src="https://cdn.eu.amplitude.com/script/1386965d11c5c16f9c9d8b119fcb876f.js" onload="
      try {
        if(window.amplitude && typeof window.amplitude.init === 'function' && localStorage.getItem('ai_hub_cookie_consent') === 'granted'){ 
          window.amplitude.init('1386965d11c5c16f9c9d8b119fcb876f', { serverZone: 'EU', autocapture: false }); 
        }
      } catch(e) {}
    "></script>

    <!-- Global Analytics Helper (No console logs in Production) -->
    <script is:inline>
      window.sendAmplitudeEvent = function(eventName, eventProperties) {
        try {
          if (window.amplitude && typeof window.amplitude.track === 'function' && localStorage.getItem('ai_hub_cookie_consent') === 'granted') {
            window.amplitude.track(eventName, eventProperties || {});
          }
        } catch (e) {}
      };
    </script>

    <!--
      Print styles (Ctrl+P).
      Завантаження PDF кнопкою НЕ використовує цей шлях — там віддається файл,
      згенерований на збірці (scripts/generate-pdfs.mjs). Ці правила потрібні
      лише щоб ручний друк сторінки не виглядав зламаним.
    -->
    <style is:global>
      @page {
        size: A4;
        margin: 14mm;
      }
      @media print {
        header, footer, #cookie-consent-banner, .no-print, nav {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          color: #000000 !important;
        }
        /* Фони карток і бренд-акценти інакше відкидаються браузером. */
        * {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }
        .max-w-7xl, .max-w-4xl {
          max-width: 100% !important;
          padding: 0 !important;
          margin: 0 !important;
        }
        .shadow-card, .shadow-sm, .shadow-2xl, .shadow-lg {
          box-shadow: none !important;
          border: 1px solid #e5e7eb !important;
        }
        /* Картки й секції не мають рватись між сторінками. */
        section, article, figure, img, .shadow-card {
          break-inside: avoid;
        }
        h1, h2, h3, h4 {
          break-after: avoid;
        }
        p, li {
          orphans: 3;
          widows: 3;
        }
        /* Жодних фіксованих шарів у друці — саме вони давали накладання тексту. */
        .fixed, .sticky {
          position: static !important;
        }
      }
    </style>
  </head>
  <body class="bg-[#F8F8FC] bg-[url('/assets/bg-mesh-light.svg')] bg-cover bg-top bg-no-repeat text-text-main font-roboto min-h-screen flex flex-col antialiased selection:bg-brand-red selection:text-white relative">
    <Header />
    <slot />
    <Footer />
    <CookieConsent />
  </body>
</html>
