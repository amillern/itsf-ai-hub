---
import Layout from '../layouts/Layout.astro';
import { techLogos } from '../data/techLogos';

const promoSlides = [
  {
    id: "slide-1",
    badge1: "Інфраструктура та експлуатація",
    badge2: "Операційна діяльність",
    label: "Останні додані",
    title: "Автоматична генерація звітів з інфраструктури",
    subtitle: "Роботизований збір інфраструктурних метрик та миттєва генерація бізнес-звітів для менеджменту.",
    description: "Після проведення навантажувальних або регресійних тестів інженери витрачають години на вивантаження даних із баз моніторингу, ручне зведення графіків, пошук інтервалів деградації та оформлення презентацій для керівництва.",
    link: "/cases/business-analytics/"
  },
  {
    id: "slide-2",
    badge1: "Прискорення розробки ПЗ",
    badge2: "Операційна діяльність",
    label: "Популярний кейс",
    title: "Підвищення продуктивності команд розробки",
    subtitle: "Пілотування ШІ-інструмента GitHub Copilot в IT SmartFlex з метою оцінки його реального впливу на швидкість розробки.",
    description: "Вимірювання приросту ефективності інженерів при написанні коду, автоматичній генерації автотестів та рефакторингу за допомогою ШІ-копайлотів.",
    link: "/cases/copilot-dev/"
  },
  {
    id: "slide-3",
    badge1: "Аналіз та пошук інформації",
    badge2: "Оптимізація витрат",
    label: "Корпоративні рішення",
    title: "Інтелектуальний аналіз документів та юридичних актів",
    subtitle: "DocAI система для автоматичного витягу сутностей з первинної документації та договорів.",
    description: "Автоматичне виявлення ризикових пунктів у договорах, автоматичне структурування вхідних актів та прискорення роботи юридичного відділу в 10 разів.",
    link: "/cases/doc-ai/"
  },
  {
    id: "slide-4",
    badge1: "Аналіз та пошук інформації",
    badge2: "Підвищення якості комунікацій",
    label: "База знань",
    title: "Корпоративна база знань з ШІ-пошуком (RAG)",
    subtitle: "Внутрішня пошукова система для співробітників за регламентами, інструкціями та базою коду.",
    description: "Миттєві точні відповіді з посиланнями на першоджерела у закритій базі Confluence, Notion та корпоративних документах компанії.",
    link: "/cases/rag-knowledge-base/"
  }
];

const taskPillsWithColors = [
  { label: "Підвищення продуктивності", borderColor: "border-brand-red text-text-main" },
  { label: "Автоматизація процесів", borderColor: "border-rose-300 text-text-main" },
  { label: "Оптимізація витрат", borderColor: "border-sky-400 text-text-main" },
  { label: "Покращення клієнтського сервісу", borderColor: "border-emerald-500 text-text-main" },
  { label: "Прискорення розробки ПЗ", borderColor: "border-blue-400 text-text-main" },
  { label: "Аналіз та пошук інформації", borderColor: "border-indigo-300 text-text-main" },
  { label: "Підвищення якості комунікацій", borderColor: "border-amber-400 text-text-main" },
  { label: "Скорочення часу виконання задач", borderColor: "border-teal-400 text-text-main" },
  { label: "Підтримка прийняття рішень", borderColor: "border-amber-800 text-text-main" },
];
---

<Layout title="AI Hub - Головна | IT SmartFlex">
  
  <!-- Top Hero Zone -->
  <section class="pt-20 sm:pt-36 lg:pt-48 pb-20 sm:pb-32 lg:pb-40 bg-transparent text-text-main relative overflow-hidden z-0 min-h-[75vh] flex flex-col justify-center">
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16 w-full">
      
      <!-- Top Title & Subtitle Banner Area -->
      <div class="text-center max-w-5xl mx-auto space-y-6 sm:space-y-8 py-6">
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-fixel font-extrabold text-text-main tracking-tight leading-tight px-2 hover:scale-[1.01] transition-transform duration-300">
          Де і як працює штучний інтелект
        </h1>

        <p class="text-lg sm:text-2xl text-[#181818] font-roboto leading-relaxed max-w-3xl mx-auto px-2">
          Реальні приклади та сценарії застосування AI на основі практичного досвіду команди фахівців IT SmartFlex
        </p>

        <div class="pt-4 flex justify-center">
          <a 
            id="hero-start-btn"
            href="/catalog/" 
            class="group px-8 sm:px-10 py-4 bg-[#FFEBEB] border border-[#FFC2C2] text-[#5C0000] font-fixel font-bold text-sm sm:text-base rounded-full shadow-md hover:shadow-xl hover:bg-[#FCD4D4] hover:-translate-y-1 transition-all duration-300 flex items-center gap-2.5 active:scale-95"
          >
            <img src="/assets/Icon.svg" class="w-5 h-5 shrink-0 group-hover:scale-110 transition-transform duration-300" alt="" />
            <span>Розпочати знайомство</span>
          </a>
        </div>
      </div>

      <!-- Fixed Height Promo Carousel Container -->
      <div id="promo-carousel" class="mt-12 sm:mt-16 lg:mt-24 relative bg-[#0D0422]/95 backdrop-blur-xl bg-[url('/assets/bg-hero-dark.jpg')] bg-cover bg-center bg-blend-overlay rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 lg:p-14 border border-white/15 shadow-2xl text-left text-white overflow-hidden h-[460px] sm:h-[420px] flex flex-col justify-between group/carousel">
        
        <!-- Slides Track -->
        <div id="slides-container" class="relative w-full h-[320px] sm:h-[280px]">
          {promoSlides.map((slide, index) => (
            <div 
              class:list={[
                "promo-slide transition-all duration-500 space-y-3 sm:space-y-4 h-full flex flex-col justify-between",
                index === 0 ? "block opacity-100" : "hidden opacity-0 absolute inset-0"
              ]}
              data-slide-index={index}
              data-slide-title={slide.title}
            >
              <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-3 sm:px-4 py-1 rounded-full bg-gray-700/80 text-gray-200 text-[11px] sm:text-xs font-semibold hover:bg-gray-600 transition-colors">
                    {slide.badge1}
                  </span>
                  <span class="px-3 sm:px-4 py-1 rounded-full bg-brand-red text-white text-[11px] sm:text-xs font-semibold hover:bg-brand-red-dark transition-colors">
                    {slide.badge2}
                  </span>
                </div>

                <p class="text-[11px] sm:text-xs font-semibold text-gray-400 uppercase tracking-wider">
                  {slide.label}
                </p>

                <h2 class="text-xl sm:text-2xl lg:text-3xl font-fixel font-bold text-white leading-snug line-clamp-1">
                  {slide.title}
                </h2>

                <p class="text-xs sm:text-base font-fixel font-semibold text-purple-200 line-clamp-1">
                  {slide.subtitle}
                </p>

                <p class="text-gray-300 text-xs sm:text-sm leading-relaxed max-w-4xl font-roboto line-clamp-3">
                  {slide.description}
                </p>
              </div>

              <div>
                <a 
                  href={slide.link} 
                  class="promo-details-btn group/btn inline-flex items-center gap-2 px-6 sm:px-8 py-2.5 sm:py-3 bg-white text-[#181818] font-fixel font-bold text-xs sm:text-sm rounded-full hover:bg-brand-red hover:text-white transition-all duration-300 shadow-md active:scale-95"
                  data-case-title={slide.title}
                >
                  <span>Детальніше</span>
                  <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- Interactive Dot Buttons -->
        <div class="pt-4 sm:pt-6 flex items-center justify-end border-t border-white/10 mt-4">
          <div class="flex items-center gap-2.5">
            {promoSlides.map((_, index) => (
              <button 
                type="button" 
                data-dot-index={index} 
                class:list={[
                  "dot-btn w-3 h-3 rounded-full transition-all duration-300 focus:outline-none cursor-pointer p-1 hover:scale-125",
                  index === 0 ? "bg-brand-red w-7" : "bg-white/40 hover:bg-white/70"
                ]}
                aria-label={`Слайд ${index + 1}`}
              ></button>
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Section: Чому AI Hub від IT SmartFlex? -->
  <section class="py-12 sm:py-20 bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
      
      <div class="text-center">
        <h2 class="text-2xl sm:text-4xl font-fixel font-extrabold text-text-main">
          Чому AI Hub від IT SmartFlex?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Card 1 -->
        <div class="group bg-[#E5E5E5]/90 backdrop-blur-md rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 space-y-4 sm:space-y-5 shadow-sm border border-gray-200 hover:-translate-y-2 hover:shadow-xl hover:border-gray-300 transition-all duration-300">
          <div class="w-12 h-12 rounded-full border border-gray-400 text-text-main flex items-center justify-center group-hover:scale-110 group-hover:border-brand-red group-hover:text-brand-red transition-all duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9 9 0 1020.945 13H11V3.055z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-fixel font-bold text-[#A10000] group-hover:text-brand-red transition-colors">
            Перевірено на практиці
          </h3>
          <p class="text-[#181818] text-xs sm:text-base leading-relaxed font-roboto">
            Усі кейси базуються на реальному досвіді застосування ШІ в бізнес- та операційних процесах
          </p>
        </div>

        <!-- Card 2 -->
        <div class="group bg-gradient-to-br from-[#FCE7FE] to-[#D5D4FF] rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 space-y-4 sm:space-y-5 shadow-sm border border-purple-100 hover:-translate-y-2 hover:shadow-xl hover:border-purple-200 transition-all duration-300">
          <div class="w-12 h-12 rounded-full border border-purple-400 text-text-main flex items-center justify-center group-hover:scale-110 group-hover:border-brand-red group-hover:text-brand-red transition-all duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-fixel font-bold text-[#A10000] group-hover:text-brand-red transition-colors">
            Реальний результат
          </h3>
          <p class="text-[#181818] text-xs sm:text-base leading-relaxed font-roboto">
            Кожен кейс демонструє не технологію заради технології, а конкретну задачу та отриману цінність.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="group bg-[#E5E5E5]/90 backdrop-blur-md rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 space-y-4 sm:space-y-5 shadow-sm border border-gray-200 hover:-translate-y-2 hover:shadow-xl hover:border-gray-300 transition-all duration-300">
          <div class="w-12 h-12 rounded-full border border-gray-400 text-text-main flex items-center justify-center group-hover:scale-110 group-hover:border-brand-red group-hover:text-brand-red transition-all duration-300">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" stroke-width="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 15L15 9m0 0H10m5 0v5"/>
            </svg>
          </div>
          <h3 class="text-xl sm:text-2xl font-fixel font-bold text-[#A10000] group-hover:text-brand-red transition-colors">
            Масштабовані рішення
          </h3>
          <p class="text-[#181818] text-xs sm:text-base leading-relaxed font-roboto">
            Підходи та сценарії, які можуть бути адаптовані для різних галузей і функцій.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Section: Оберіть задачу, яку хочете вирішити (Clean Navigation Directly to Catalog) -->
  <section class="py-10 sm:py-16 bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 sm:space-y-10 text-center">
      
      <h2 class="text-2xl sm:text-4xl font-fixel font-extrabold text-text-main">
        Оберіть задачу, яку хочете вирішити
      </h2>

      <div class="flex flex-wrap justify-center gap-2 sm:gap-3.5 max-w-5xl mx-auto">
        {taskPillsWithColors.map(pill => (
          <a 
            href={`/catalog/?tag=${encodeURIComponent(pill.label)}`}
            class:list={[
              "task-pill-badge px-4 sm:px-6 py-2.5 sm:py-3 rounded-full bg-white font-fixel text-xs sm:text-sm font-medium shadow-sm border transition-all duration-200 hover:shadow-md hover:scale-105 hover:border-brand-red cursor-pointer",
              pill.borderColor
            ]}
            data-task-name={pill.label}
          >
            {pill.label}
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Section: Практичний досвід AI-розробок -->
  <section class="py-12 sm:py-20 bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
      
      <div class="text-center">
        <h2 class="text-2xl sm:text-4xl font-fixel font-extrabold text-text-main">
          Практичний досвід AI-розробок
        </h2>
      </div>

      <!-- 7 White Cards Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-4">
        {techLogos.map(item => (
          <div class="group bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-6 border border-gray-100 shadow-sm flex flex-col items-center justify-between text-center space-y-3 min-h-[140px] sm:min-h-[160px] hover:-translate-y-2 hover:shadow-xl hover:border-brand-red/30 transition-all duration-300">
            <div class="flex items-center justify-center min-h-[50px] sm:min-h-[60px] w-full">
              {item.img ? (
                <img 
                  src={item.img} 
                  alt={item.name} 
                  class="max-h-10 sm:max-h-12 w-auto object-contain group-hover:scale-110 transition-transform duration-300" 
                />
              ) : (
                <div class="group-hover:scale-110 transition-transform duration-300">
                  <Fragment set:html={item.svg} />
                </div>
              )}
            </div>
            <span class="text-[11px] sm:text-xs font-bold text-text-main font-fixel leading-tight group-hover:text-brand-red transition-colors">
              {item.name}
            </span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Consultation Banner -->
  <section class="py-8 sm:py-12 bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-gradient-to-r from-[#002B99] via-[#0A115E] to-[#120440] rounded-[24px] sm:rounded-[32px] p-6 sm:p-10 lg:p-14 text-white relative overflow-hidden shadow-popup grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center group/banner">
        
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-blue-500/20 rounded-full blur-[100px] pointer-events-none group-hover/banner:scale-125 transition-transform duration-700"></div>

        <div class="lg:col-span-8 space-y-4 sm:space-y-6 relative z-10">
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-fixel font-extrabold text-white tracking-tight leading-tight">
            Маєте задачу, але не знаєте, чи допоможе AI?
          </h2>

          <p class="text-gray-200 text-xs sm:text-lg leading-relaxed max-w-2xl font-roboto">
            Обговоримо ваш сценарій та запропонуємо можливі підходи до автоматизації, підвищення продуктивності або покращення сервісу.
          </p>

          <div class="pt-2">
            <a 
              id="get-consultation-btn"
              href="/contacts/" 
              class="group/consult inline-flex items-center justify-center w-full sm:w-auto px-6 sm:px-8 py-3.5 sm:py-4 bg-brand-red hover:bg-brand-red-dark text-white font-fixel font-bold text-xs sm:text-base rounded-full shadow-lg hover:shadow-[0_10px_30px_rgba(230,0,0,0.4)] hover:-translate-y-0.5 transition-all duration-300 active:scale-95 gap-2"
            >
              <span>Отримати консультацію</span>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 group-hover/consult:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right 3D Glowing Text AI Graphic -->
        <div class="lg:col-span-4 flex justify-center lg:justify-end relative z-10">
          <div class="text-6xl sm:text-8xl lg:text-9xl font-fixel font-black tracking-widest text-transparent bg-clip-text bg-gradient-to-b from-white via-blue-100 to-blue-300 drop-shadow-[0_0_35px_rgba(255,255,255,0.6)] select-none group-hover/banner:scale-105 transition-transform duration-500">
            AI
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Interactive Carousel & Amplitude Triggers JavaScript -->
  <script>
    let currentSlide = 0;
    const slides = document.querySelectorAll('.promo-slide');
    const dotBtns = document.querySelectorAll('.dot-btn');
    const totalSlides = slides.length;
    let autoSlideTimer: any;

    function goToSlide(index: number, isManual = false) {
      currentSlide = index;

      slides.forEach((slide, idx) => {
        if (idx === currentSlide) {
          slide.classList.remove('hidden', 'opacity-0', 'absolute', 'inset-0');
          slide.classList.add('block', 'opacity-100');

          // ONLY fire Amplitude event when user clicks manually!
          if (isManual && typeof (window as any).sendAmplitudeEvent === 'function') {
            const slideTitle = slide.getAttribute('data-slide-title') || '';
            (window as any).sendAmplitudeEvent('carousel_slide_change', {
              slide_index: idx,
              slide_title: slideTitle,
              manual_click: true
            });
          }
        } else {
          slide.classList.remove('block', 'opacity-100');
          slide.classList.add('hidden', 'opacity-0', 'absolute', 'inset-0');
        }
      });

      dotBtns.forEach((dot, idx) => {
        if (idx === currentSlide) {
          dot.classList.remove('bg-white/40', 'w-3');
          dot.classList.add('bg-brand-red', 'w-7');
        } else {
          dot.classList.remove('bg-brand-red', 'w-7');
          dot.classList.add('bg-white/40', 'w-3');
        }
      });
    }

    function prevSlide() {
      const prev = (currentSlide - 1 + totalSlides) % totalSlides;
      goToSlide(prev, true);
    }

    function nextSlide() {
      const next = (currentSlide + 1) % totalSlides;
      goToSlide(next, false);
    }

    dotBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const index = parseInt(target.getAttribute('data-dot-index') || '0', 10);
        goToSlide(index, true);
        resetAutoSlide();
      });
    });

    const carouselEl = document.getElementById('promo-carousel');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (carouselEl) {
      // Pause auto-sliding on mouse hover or focus
      carouselEl.addEventListener('mouseenter', () => clearInterval(autoSlideTimer));
      carouselEl.addEventListener('mouseleave', () => resetAutoSlide());

      // Keyboard navigation (ArrowLeft / ArrowRight)
      carouselEl.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          prevSlide();
          resetAutoSlide();
        } else if (e.key === 'ArrowRight') {
          nextSlide();
          resetAutoSlide();
        }
      });
    }

    function resetAutoSlide() {
      clearInterval(autoSlideTimer);
      if (!prefersReducedMotion) {
        autoSlideTimer = setInterval(nextSlide, 7000);
      }
    }

    resetAutoSlide();

    // Event Triggers & GA4 Conversions
    document.getElementById('hero-start-btn')?.addEventListener('click', () => {
      if (typeof (window as any).sendAmplitudeEvent === 'function') {
        (window as any).sendAmplitudeEvent('click_start_discovery', { source: 'hero' });
      }
    });

    document.getElementById('get-consultation-btn')?.addEventListener('click', () => {
      if (typeof (window as any).sendAmplitudeEvent === 'function') {
        (window as any).sendAmplitudeEvent('click_get_consultation', { destination: 'contacts' });
      }
      // @ts-ignore
      if (typeof window.gtag === 'function') {
        // @ts-ignore
        window.gtag('event', 'select_content', {
          content_type: 'consultation_button',
          destination: 'contacts'
        });
      }
    });

    document.querySelectorAll('.task-pill-badge').forEach(pill => {
      pill.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const taskName = target.getAttribute('data-task-name') || '';
        if (typeof (window as any).sendAmplitudeEvent === 'function') {
          (window as any).sendAmplitudeEvent('click_task_pill', { task_name: taskName });
        }
      });
    });
  </script>

</Layout>
