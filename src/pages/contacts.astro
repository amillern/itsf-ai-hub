---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title="Контакти | IT SmartFlex AI Hub">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24 space-y-10">
    
    <!-- Main Header Title -->
    <div class="text-center">
      <h1 class="text-4xl sm:text-5xl font-fixel font-extrabold text-text-main tracking-tight">
        Контакти
      </h1>
    </div>

    <!-- Main Full-Width Dark Card Container with Rich Figma Gradient & Ambient Glow -->
    <div class="bg-[#0C031D] bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-[#280A54] via-[#0D0322] to-[#04000C] rounded-[28px] sm:rounded-[36px] p-6 sm:p-10 lg:p-14 border border-white/15 shadow-2xl text-white relative overflow-hidden">
      
      <!-- Background Ambient Glow Accents -->
      <div class="absolute -top-24 -left-24 w-96 h-96 bg-purple-600/25 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-brand-red/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-1/2 left-1/3 w-80 h-80 bg-indigo-900/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start relative z-10">
        
        <!-- Left Column: Discuss Task, Email & LinkedIn -->
        <div class="lg:col-span-5 space-y-10">
          
          <!-- Block 1: Обговорити вашу задачу -->
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-fixel font-extrabold text-white leading-tight">
              Обговорити вашу задачу
            </h2>
            <p class="text-gray-300 text-sm sm:text-base leading-relaxed font-roboto">
              Не всі сценарії застосування штучного інтелекту можна описати готовими кейсами. Розкажіть про ваші бізнес-процеси, виклики або ідеї - допоможемо визначити можливості використання AI саме для вашої організації.
            </p>
          </div>

          <!-- Block 2: Напишіть нам -->
          <div class="space-y-2">
            <h3 class="text-xl sm:text-2xl font-fixel font-bold text-white">
              Напишіть нам
            </h3>
            <a 
              href="mailto:contact_us@itsmartflex.com" 
              class="text-sm sm:text-base text-gray-300 hover:text-white hover:underline font-roboto block"
            >
              contact_us@itsmartflex.com
            </a>
          </div>

          <!-- Block 3: Зв'яжіться через LinkedIn -->
          <div class="space-y-4 pt-2">
            <div class="space-y-2">
              <h3 class="text-xl sm:text-2xl font-fixel font-bold text-white">
                Зв'яжіться через LinkedIn
              </h3>
              <p class="text-sm text-gray-300 font-roboto">
                Слідкуйте за оновленнями та зв'яжіться з командою IT SmartFlex
              </p>
            </div>

            <div>
              <a 
                href={siteConfig.company.linkedin} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-white/30 bg-white/5 hover:bg-white/15 text-white font-fixel text-sm font-semibold transition-all duration-300 active:scale-95 shadow-sm"
              >
                <span class="text-lg leading-none">+</span>
                <span>LinkedIn IT SmartFlex</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Right Column: Form Heading & Dark Form Fields -->
        <div class="lg:col-span-7 space-y-6">
          
          <div class="space-y-2">
            <h2 class="text-2xl sm:text-3xl font-fixel font-extrabold text-white">
              Форма зворотного зв'язку
            </h2>
            <p class="text-gray-300 text-sm font-roboto">
              Розкажіть про свою задачу
            </p>
          </div>

          <form id="contact-form" novalidate class="space-y-4 font-roboto">
            
            <!-- Row 1: Name & Surname side-by-side -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <input 
                  type="text" 
                  id="firstName" 
                  name="firstName" 
                  placeholder="Ім'я *" 
                  class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all"
                />
                <span id="err-firstName" class="text-rose-400 text-xs mt-1 hidden">Будь ласка, вкажіть ваше ім'я</span>
              </div>

              <div>
                <input 
                  type="text" 
                  id="lastName" 
                  name="lastName" 
                  placeholder="Прізвище *" 
                  class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all"
                />
                <span id="err-lastName" class="text-rose-400 text-xs mt-1 hidden">Будь ласка, вкажіть ваше прізвище</span>
              </div>
            </div>

            <!-- Row 2: Company -->
            <div>
              <input 
                type="text" 
                id="company" 
                name="company" 
                placeholder="Компанія *" 
                class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all"
              />
              <span id="err-company" class="text-rose-400 text-xs mt-1 hidden">Будь ласка, вкажіть назву вашої компанії</span>
            </div>

            <!-- Row 3: Email -->
            <div>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="Email *" 
                class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all"
              />
              <span id="err-email" class="text-rose-400 text-xs mt-1 hidden">Будь ласка, введіть дійсний Email (наприклад: name@company.com)</span>
            </div>

            <!-- Row 4: Phone (Strict Numeric & Format Validation) -->
            <div>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                placeholder="Телефон *" 
                class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all"
              />
              <span id="err-phone" class="text-rose-400 text-xs mt-1 hidden">Введіть дійсний номер телефону (наприклад: +380 50 123 45 67)</span>
            </div>

            <!-- Row 5: Position -->
            <div>
              <input 
                type="text" 
                id="position" 
                name="position" 
                placeholder="Посада *" 
                class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all"
              />
              <span id="err-position" class="text-rose-400 text-xs mt-1 hidden">Будь ласка, вкажіть вашу посаду</span>
            </div>

            <!-- Row 6: Short task description -->
            <div>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                placeholder="Короткий опис задачі" 
                class="form-input w-full px-4 py-3.5 bg-[#14082B] border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:border-purple-400 focus:bg-[#1A0B38] focus:ring-2 focus:ring-purple-400/30 transition-all resize-none"
              ></textarea>
              <span id="err-message" class="text-rose-400 text-xs mt-1 hidden">Будь ласка, напишіть короткий опис вашої задачі</span>
            </div>

            <!-- Submit Button (White Pill with Red Text) -->
            <div class="pt-2">
              <button 
                id="submit-btn"
                type="submit" 
                class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-brand-red font-fixel font-bold text-sm sm:text-base rounded-full shadow-lg hover:bg-gray-100 transition-all duration-300 active:scale-95 cursor-pointer disabled:opacity-50"
              >
                <svg class="w-4 h-4 fill-brand-red transform rotate-45" viewBox="0 0 24 24">
                  <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
                <span id="submit-text">Обговорити задачу</span>
              </button>
            </div>
          </form>

          <!-- Success Notification -->
          <div id="form-success" class="hidden mt-4 p-4 bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 rounded-xl text-sm font-medium items-center gap-3">
            <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Дякуємо! Найближчим часом з вами зв'яжуться наші фахівці.</span>
          </div>

        </div>

      </div>

    </div>

  </div>

  <style is:inline>
    #contact-form input, #contact-form textarea {
      background-color: #14082B !important;
      color: #FFFFFF !important;
    }
    #contact-form input:-webkit-autofill,
    #contact-form input:-webkit-autofill:hover, 
    #contact-form input:-webkit-autofill:focus, 
    #contact-form textarea:-webkit-autofill,
    #contact-form textarea:-webkit-autofill:hover,
    #contact-form textarea:-webkit-autofill:focus {
      -webkit-text-fill-color: #ffffff !important;
      -webkit-box-shadow: 0 0 0px 1000px #14082B inset !important;
      transition: background-color 5000s ease-in-out 0s !important;
    }
    .field-invalid {
      border-color: #f43f5e !important;
    }
  </style>

  <script is:inline>
    (function() {
      // Configuration for Google Sheets Apps Script Web App
      var GOOGLE_SCRIPT_WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbxL0bx2s0YynFC-cXgHNFEJjBcFZOXjkUhES7FFiA5p1u8AsdHeQ2UtJmPRZPlkW18/exec';

      var form = document.getElementById('contact-form');
      var successMsg = document.getElementById('form-success');
      var phoneInput = document.getElementById('phone');
      var submitBtn = document.getElementById('submit-btn');
      var submitText = document.getElementById('submit-text');

      if (!form) return;

      if (phoneInput) {
        phoneInput.addEventListener('keydown', function(e) {
          if (['Backspace', 'Tab', 'Enter', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].indexOf(e.key) !== -1 || e.ctrlKey || e.metaKey) {
            return;
          }
          if (!/^[0-9+\s()\x2d]$/.test(e.key)) {
            e.preventDefault();
          }
        });
      }

      function validateField(id, fn) {
        var el = document.getElementById(id);
        var errEl = document.getElementById('err-' + id);
        if (!el) return true;
        var isValid = fn(el.value.trim());
        if (!isValid) {
          el.classList.add('field-invalid');
          if (errEl) errEl.classList.remove('hidden');
        } else {
          el.classList.remove('field-invalid');
          if (errEl) errEl.classList.add('hidden');
        }
        return isValid;
      }

      function checkFirstName(val) { return val.length > 0; }
      function checkLastName(val) { return val.length > 0; }
      function checkCompany(val) { return val.length > 0; }
      function checkPosition(val) { return val.length > 0; }
      function checkEmail(val) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val); }
      function checkPhone(val) {
        var digits = val.replace(/\D/g, '');
        return digits.length >= 7 && digits.length <= 15 && /^[+\d\s()\x2d]+$/.test(val);
      }
      function checkMessage(val) { return val.length > 0; }

      var fields = [
        { id: 'firstName', fn: checkFirstName },
        { id: 'lastName', fn: checkLastName },
        { id: 'company', fn: checkCompany },
        { id: 'email', fn: checkEmail },
        { id: 'phone', fn: checkPhone },
        { id: 'position', fn: checkPosition },
        { id: 'message', fn: checkMessage }
      ];

      fields.forEach(function(item) {
        var el = document.getElementById(item.id);
        if (el) {
          el.addEventListener('blur', function() {
            if (el.value.trim().length > 0) {
              validateField(item.id, item.fn);
            }
          });
          el.addEventListener('input', function() {
            el.classList.remove('field-invalid');
            var errEl = document.getElementById('err-' + item.id);
            if (errEl) errEl.classList.add('hidden');
          });
        }
      });

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        var validFirst = validateField('firstName', checkFirstName);
        var validLast = validateField('lastName', checkLastName);
        var validComp = validateField('company', checkCompany);
        var validMail = validateField('email', checkEmail);
        var validPhone = validateField('phone', checkPhone);
        var validPos = validateField('position', checkPosition);
        var validMsg = validateField('message', checkMessage);

        var isAllValid = validFirst && validLast && validComp && validMail && validMail && validPhone && validPos && validMsg;

        if (isAllValid) {
          var payload = {
            firstName: document.getElementById('firstName').value.trim(),
            lastName: document.getElementById('lastName').value.trim(),
            company: document.getElementById('company').value.trim(),
            email: document.getElementById('email').value.trim(),
            phone: document.getElementById('phone').value.trim(),
            position: document.getElementById('position').value.trim(),
            message: document.getElementById('message').value.trim()
          };

          if (submitBtn && submitText) {
            submitBtn.disabled = true;
            submitText.textContent = "Надсилання...";
          }

          if (GOOGLE_SCRIPT_WEBHOOK_URL) {
            fetch(GOOGLE_SCRIPT_WEBHOOK_URL, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            }).then(function() {
              onSuccess();
            }).catch(function() {
              onSuccess();
            });
          } else {
            // Local fallback simulation
            setTimeout(onSuccess, 500);
          }
        }

        function onSuccess() {
          if (submitBtn && submitText) {
            submitBtn.disabled = false;
            submitText.textContent = "Обговорити задачу";
          }
          if (successMsg) {
            successMsg.classList.remove('hidden');
            successMsg.classList.add('flex');
          }
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('submit_contact_form', payload);
          }
          form.reset();
        }
      });
    })();
  </script>
</Layout>
