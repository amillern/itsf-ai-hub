---
import Layout from '../layouts/Layout.astro';
import FigmaCardUseCases from '../components/figma/FigmaCardUseCases.astro';
import FigmaCardBusinessCases from '../components/figma/FigmaCardBusinessCases.astro';
import FigmaButton from '../components/figma/FigmaButton.astro';
import { caseStudies } from '../data/cases';

const catalogItems = caseStudies.map(item => ({
  id: item.id,
  slug: item.slug,
  title: item.title.uk,
  type: item.type,
  typeLabel: item.type === 'usecase' ? 'Use Case' : 'Case Studies',
  image: item.bannerImage,
  category: item.badge.uk,
  tags: item.tags,
  description: item.overview.uk
}));

// Cleaned list containing ONLY active tags that return non-empty search results
const activeCatalogFilterTags = Array.from(
  new Set(catalogItems.flatMap(item => item.tags))
);
---

<Layout title="Каталог AI-рішень | IT SmartFlex">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 space-y-8 sm:space-y-10">
    
    <!-- Breadcrumbs -->
    <nav class="flex flex-wrap items-center text-xs text-[#515151] gap-1.5 sm:gap-2">
      <a href="/" class="hover:text-brand-red font-medium">Головна</a>
      <span>/</span>
      <span class="text-text-main font-semibold">Каталог AI-рішень</span>
    </nav>

    <!-- Main Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 sm:space-y-4">
      <h1 class="text-3xl sm:text-5xl font-fixel font-extrabold text-text-main tracking-tight leading-tight">
        AI-рішення для бізнесу та команд
      </h1>
      
      <p class="text-sm sm:text-lg text-text-muted font-roboto leading-relaxed">
        Практичні кейси та сценарії застосування штучного інтелекту на основі досвіду команди IT SmartFlex.
      </p>
    </div>

    <!-- Floating Type Tabs Bar mobile optimized -->
    <div class="flex justify-center w-full overflow-x-auto no-scrollbar py-1">
      <div class="bg-white shadow-pill border border-gray-100 p-1.5 rounded-full inline-flex items-center gap-1 sm:gap-1.5 z-20 shrink-0">
        
        <button 
          data-type-tab="all" 
          class="type-tab-btn active px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-fixel font-semibold flex items-center gap-1.5 bg-brand-red-soft text-text-main transition-all shadow-sm"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-main" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span>Усі</span>
        </button>

        <button 
          data-type-tab="business" 
          class="type-tab-btn px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-fixel font-medium text-text-muted hover:bg-gray-100/80 flex items-center gap-1.5 transition-all"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Case Studies</span>
        </button>

        <button 
          data-type-tab="usecase" 
          class="type-tab-btn px-4 sm:px-6 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-fixel font-medium text-text-muted hover:bg-gray-100/80 flex items-center gap-1.5 transition-all"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Use Case</span>
        </button>

      </div>
    </div>

    <!-- Filter Control Bar -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        
        <div class="relative w-full sm:w-auto">
          <button 
            id="filter-dropdown-toggle" 
            type="button"
            class="w-full sm:w-auto px-5 py-2.5 bg-white rounded-full border border-gray-200 shadow-sm font-fixel text-sm font-semibold text-text-main flex items-center justify-between sm:justify-start gap-2 hover:bg-gray-50 transition-all active:scale-95 cursor-pointer"
          >
            <span>Фільтр</span>
            <svg class="w-4 h-4 text-text-muted transition-transform duration-200" id="filter-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div 
            id="filter-popover" 
            class="hidden absolute left-0 top-12 w-[calc(100vw-2rem)] sm:w-80 bg-white/95 backdrop-blur-md rounded-2xl p-4 shadow-popup border border-gray-100 z-40 space-y-3"
          >
            <div class="flex items-center justify-between border-b border-gray-100 pb-2">
              <span class="text-xs font-bold text-text-main uppercase tracking-wider">Вибір за бізнес-задачею</span>
              <button id="clear-all-filters-btn" class="text-xs text-brand-red hover:underline font-medium cursor-pointer">Очистити всі</button>
            </div>

            <div class="space-y-2 max-h-64 overflow-y-auto">
              {activeCatalogFilterTags.map(tag => (
                <label class="flex items-center gap-2.5 text-xs text-text-main font-medium cursor-pointer hover:bg-gray-50 p-1.5 rounded-lg transition-colors">
                  <input 
                    type="checkbox" 
                    value={tag} 
                    class="filter-checkbox w-4 h-4 rounded text-brand-red focus:ring-brand-red border-gray-300"
                  />
                  <span>{tag}</span>
                </label>
              ))}
            </div>
          </div>
        </div>

        <div id="active-chips-container" class="flex flex-wrap gap-2 items-center">
          <!-- Active tag chips dynamically rendered here -->
        </div>

      </div>
    </div>

    <!-- Cards Grid -->
    <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {catalogItems.map(item => (
        item.type === 'usecase' ? (
          <FigmaCardUseCases 
            title={item.title}
            description={item.description}
            image={item.image}
            tags={item.tags}
            slug={item.slug}
          />
        ) : (
          <FigmaCardBusinessCases 
            title={item.title}
            description={item.description}
            image={item.image}
            tags={item.tags}
            slug={item.slug}
          />
        )
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-16 sm:py-20 bg-white/60 backdrop-blur-md rounded-3xl border border-dashed border-gray-200 space-y-3 px-4">
      <p class="text-lg sm:text-xl font-fixel font-bold text-text-main">Жодного рішення не знайдено</p>
      <p class="text-xs sm:text-sm text-text-muted">Спробуйте обрати інші категорії або скинути фільтри.</p>
      <FigmaButton id="reset-filters-btn" variant="primary">
        Скинути всі фільтри
      </FigmaButton>
    </div>

  </div>

  <!-- Bulletproof Interactive Filter Logic -->
  <script>
    let activeType = 'all';
    let selectedTags: string[] = [];

    const popover = document.getElementById('filter-popover');
    const toggleBtn = document.getElementById('filter-dropdown-toggle');
    const chevron = document.getElementById('filter-chevron');
    const clearBtn = document.getElementById('clear-all-filters-btn');
    const resetBtn = document.getElementById('reset-filters-btn');
    const chipsContainer = document.getElementById('active-chips-container');
    const emptyState = document.getElementById('empty-state');
    const cardsGrid = document.getElementById('cards-grid');

    const tabBtns = document.querySelectorAll('.type-tab-btn');
    const checkboxes = document.querySelectorAll('.filter-checkbox');
    const cardElements = document.querySelectorAll('.catalog-item-card');

    // Popover Toggle
    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      popover?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });

    document.addEventListener('click', (e) => {
      if (popover && !popover.contains(e.target as Node) && !toggleBtn?.contains(e.target as Node)) {
        popover.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
      }
    });

    // Type Tabs Filtering
    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        activeType = target.getAttribute('data-type-tab') || 'all';

        tabBtns.forEach(t => {
          t.classList.remove('active', 'bg-brand-red-soft', 'text-text-main', 'shadow-sm');
          t.classList.add('text-text-muted');
        });

        target.classList.add('active', 'bg-brand-red-soft', 'text-text-main', 'shadow-sm');
        target.classList.remove('text-text-muted');

        applyFilters();

        if (typeof (window as any).sendAmplitudeEvent === 'function') {
          (window as any).sendAmplitudeEvent('catalog_tab_select', { type: activeType });
        }
      });
    });

    // Checkboxes Tag Filtering
    checkboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        updateSelectedTags();
        applyFilters();
      });
    });

    function updateSelectedTags() {
      selectedTags = [];
      checkboxes.forEach(cb => {
        const input = cb as HTMLInputElement;
        if (input.checked) {
          selectedTags.push(input.value);
        }
      });
      renderChips();
    }

    function renderChips() {
      if (!chipsContainer) return;
      chipsContainer.innerHTML = '';

      selectedTags.forEach(tag => {
        const chip = document.createElement('span');
        chip.className = 'inline-flex items-center gap-1 px-3 py-1 bg-gray-200 text-text-main text-xs font-semibold rounded-full font-roboto transition-all';
        chip.innerHTML = `
          <span>${tag}</span>
          <button type="button" class="remove-chip-btn hover:text-brand-red font-bold text-sm ml-0.5" data-tag="${tag}">×</button>
        `;
        chipsContainer.appendChild(chip);
      });

      document.querySelectorAll('.remove-chip-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const tag = (e.currentTarget as HTMLElement).getAttribute('data-tag');
          if (tag) {
            checkboxes.forEach(cb => {
              const input = cb as HTMLInputElement;
              if (input.value === tag) input.checked = false;
            });
            updateSelectedTags();
            applyFilters();
          }
        });
      });
    }

    clearBtn?.addEventListener('click', resetAll);
    resetBtn?.addEventListener('click', resetAll);

    function resetAll() {
      selectedTags = [];
      checkboxes.forEach(cb => { (cb as HTMLInputElement).checked = false; });
      updateSelectedTags();
      applyFilters();
    }

    function applyFilters() {
      let visibleCount = 0;

      cardElements.forEach(card => {
        const itemType = card.getAttribute('data-type') || '';
        const itemTagsString = card.getAttribute('data-tags') || '';
        const itemTags = itemTagsString.split('|||');

        const matchesType = (activeType === 'all') || (itemType === activeType);
        
        let matchesTags = true;
        if (selectedTags.length > 0) {
          matchesTags = selectedTags.every(st => itemTags.includes(st));
        }

        if (matchesType && matchesTags) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
        cardsGrid?.classList.add('hidden');
      } else {
        emptyState?.classList.add('hidden');
        cardsGrid?.classList.remove('hidden');
      }
    }
  </script>
</Layout>
