---
import Layout from '../../layouts/Layout.astro';
import CaseDetailSections from '../../sections/CaseDetailSections.astro';
import { caseStudies } from '../../data/cases';

export function getStaticPaths() {
  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
---

<Layout 
  title={`${caseStudy.title.uk} | IT SmartFlex AI Hub`}
  description={caseStudy.subtitle.uk}
  image={caseStudy.bannerImage}
  type="article"
  lang="uk"
>
  <CaseDetailSections caseStudy={caseStudy} lang="uk" />
</Layout>
