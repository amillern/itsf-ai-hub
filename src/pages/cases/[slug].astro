---
import Layout from '../../layouts/Layout.astro';
import FigmaStatusBadge from '../../components/figma/FigmaStatusBadge.astro';
import { caseStudies } from '../../data/cases';

export async function getStaticPaths() {
  return caseStudies.map(item => ({
    params: { slug: item.slug },
    props: { caseStudy: item }
  }));
}

const { caseStudy } = Astro.props;
---

<Layout title={`${caseStudy.title.uk} | IT SmartFlex AI Hub`} description={caseStudy.overview.uk} image={caseStudy.bannerImage} type="article">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 space-y-8 sm:space-y-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex flex-wrap items-center text-xs text-[#515151] gap-1.5 sm:gap-2 font-roboto no-print">
      <a href="/" class="hover:text-brand-red font-medium">Головна</a>
      <span>/</span>
      <a href="/cases/" class="hover:text-brand-red font-medium">Case Studies</a>
      <span>/</span>
      <span class="text-text-main font-semibold truncate max-w-xs">{caseStudy.title.uk}</span>
    </nav>

    <!-- Main Grid Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Case Meta, Title, Business Tasks & Share Toolbar -->
      <div class="lg:col-span-5 space-y-6 sm:space-y-8">
        
        <div>
          <FigmaStatusBadge variant="business">
            {caseStudy.badge.uk}
          </FigmaStatusBadge>
        </div>

        <div class="space-y-2">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-fixel font-extrabold text-text-main leading-tight tracking-tight">
            {caseStudy.title.uk}
          </h1>

          <p class="text-base sm:text-lg text-text-muted font-roboto leading-relaxed">
            {caseStudy.subtitle.uk}
          </p>
        </div>

        <!-- Section: Бізнес задача -->
        <div class="space-y-3 pt-2">
          <h3 class="text-base sm:text-lg font-fixel font-bold text-brand-red-dark">
            Бізнес задача:
          </h3>

          <div class="flex flex-wrap gap-2">
            {caseStudy.tags.map(tag => (
              <span class="px-3.5 sm:px-4 py-1.5 sm:py-2 bg-white border border-gray-300 text-text-main text-[11px] sm:text-xs font-semibold rounded-full shadow-sm font-roboto">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Section: Сфера застосування -->
        <div class="space-y-3 pt-2">
          <h3 class="text-base sm:text-lg font-fixel font-bold text-brand-red-dark">
            Сфера застосування:
          </h3>

          <p class="text-sm text-text-main font-semibold leading-relaxed font-roboto">
            {caseStudy.scope.uk}
          </p>
        </div>

        <!-- Complexity Comparison Box -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white border border-gray-100 shadow-sm space-y-3">
          <h4 class="text-xs font-bold text-text-muted uppercase tracking-wider">Складність впровадження</h4>
          <div class="grid grid-cols-2 gap-3 text-xs sm:text-sm font-roboto">
            <div class="p-3 rounded-xl bg-gray-50 border border-gray-200">
              <span class="text-gray-500 block text-[11px]">Без ШІ</span>
              <span class="font-bold text-rose-600">{caseStudy.difficultyWithout.uk}</span>
            </div>
            <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
              <span class="text-emerald-700 block text-[11px]">З ШІ</span>
              <span class="font-bold text-emerald-800">{caseStudy.difficultyWith.uk}</span>
            </div>
          </div>
        </div>

        <!-- Share Action Toolbar -->
        <div class="p-5 rounded-2xl bg-white border border-gray-100 shadow-card space-y-3.5 no-print">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-text-main uppercase tracking-wider font-fixel flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-red shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              <span>Поділитись кейсом</span>
            </h4>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <!-- 1. Copy Link Button -->
            <button 
              id="share-copy-btn"
              type="button" 
              class="w-full px-3 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-text-main text-xs font-bold font-fixel transition-all duration-200 flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer"
            >
              <svg class="w-4 h-4 text-gray-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
              <span>Скопіювати</span>
            </button>

            <!-- 2. Share to LinkedIn Button -->
            <a 
              id="share-linkedin-btn"
              href="#" 
              target="_blank"
              rel="noopener noreferrer"
              class="w-full px-3 py-2.5 rounded-xl bg-[#0A66C2] hover:bg-[#084e96] text-white text-xs font-bold font-fixel transition-all duration-200 flex items-center justify-center gap-1.5 shadow-sm active:scale-95"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.6a1.49 1.49 0 0 0-1.49 1.49c0 .82.67 1.49 1.49 1.49a1.49 1.49 0 0 0 1.49-1.49c0-.82-.67-1.49-1.49-1.49Z" />
              </svg>
              <span>LinkedIn</span>
            </a>

            <!-- 3. Download PDF Button -->
            <button 
              id="share-pdf-btn"
              type="button"
              class="w-full px-3 py-2.5 rounded-xl bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold font-fixel transition-all duration-200 flex items-center justify-center gap-1.5 shadow-sm active:scale-95 cursor-pointer"
            >
              <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Скачати PDF</span>
            </button>
          </div>

          <!-- Toast Feedback -->
          <div id="share-copy-toast" class="hidden text-xs text-emerald-600 font-semibold pt-1 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Посилання успішно скопійовано в буфер обміну!</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Banner & Detailed Solution Cards -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8">
        
        <!-- Banner Image -->
        <div class="rounded-[24px] sm:rounded-[32px] overflow-hidden border border-gray-100 shadow-card bg-surface-variant relative aspect-[16/9] group">
          <img 
            src={caseStudy.bannerImage} 
            alt={caseStudy.title.uk}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
          />
        </div>

        <!-- Top Card: Огляд рішення -->
        <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-8 border border-gray-100 shadow-card space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-brand-red"></div>
            <h3 class="text-lg sm:text-xl font-fixel font-bold text-text-main">
              Огляд рішення
            </h3>
          </div>

          <p class="text-sm sm:text-base text-text-muted leading-relaxed font-roboto">
            {caseStudy.overview.uk}
          </p>
        </div>

        <!-- Bottom Card: 2x2 Grid -->
        <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-8 border border-gray-100 shadow-card grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
          
          <!-- Item 1: Бізнес виклик -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Бізнес виклик:
            </h4>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
              {caseStudy.challenge.uk}
            </p>
          </div>

          <!-- Item 2: Рішення -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Рішення:
            </h4>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
              {caseStudy.solution.uk}
            </p>
          </div>

          <!-- Item 3: Цінність для бізнесу -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Цінність для бізнесу:
            </h4>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
              {caseStudy.metrics.map(m => `${m.label.uk}: ${m.value}`).join('. ')}
            </p>
          </div>

          <!-- Item 4: Технологічний стек -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Технологічний стек:
            </h4>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {caseStudy.techStack.map(t => (
                <span class="px-2.5 py-1 bg-gray-100 text-text-main rounded-md text-[11px] font-mono font-semibold">
                  {t}
                </span>
              ))}
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <script is:inline data-slug={caseStudy.slug} data-title={caseStudy.title.uk} data-type={caseStudy.type}>
    (function() {
      var scriptEl = document.currentScript;
      if (!scriptEl) return;
      var slug = scriptEl.getAttribute('data-slug');
      var title = scriptEl.getAttribute('data-title');
      var type = scriptEl.getAttribute('data-type');

      if (typeof window.sendAmplitudeEvent === 'function') {
        window.sendAmplitudeEvent('view_case_detail', { slug: slug, title: title, type: type });
      }

      // 1. Copy Link Handler
      var copyBtn = document.getElementById('share-copy-btn');
      var toast = document.getElementById('share-copy-toast');
      if (copyBtn) {
        copyBtn.onclick = function() {
          var currentUrl = window.location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(currentUrl);
          } else {
            var tempInput = document.createElement('input');
            tempInput.value = currentUrl;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
          }
          if (toast) {
            toast.classList.remove('hidden');
            setTimeout(function() { toast.classList.add('hidden'); }, 3000);
          }
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('share_copy_link', { slug: slug, title: title });
          }
        };
      }

      // 2. Share to LinkedIn Handler
      var linkedinBtn = document.getElementById('share-linkedin-btn');
      if (linkedinBtn) {
        var pageUrl = encodeURIComponent(window.location.href);
        linkedinBtn.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + pageUrl;
        linkedinBtn.onclick = function() {
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('share_linkedin', { slug: slug, title: title });
          }
        };
      }

      // 3. Download PDF Handler
      var pdfBtn = document.getElementById('share-pdf-btn');
      if (pdfBtn) {
        pdfBtn.onclick = function() {
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('share_download_pdf', { slug: slug, title: title });
          }
          window.print();
        };
      }
    })();
  </script>
</Layout>
