---
import Layout from '../../layouts/Layout.astro';
import FigmaStatusBadge from '../../components/figma/FigmaStatusBadge.astro';
import { caseStudies } from '../../data/cases';

export async function getStaticPaths() {
  return caseStudies.map(item => ({
    params: { slug: item.slug },
    props: { caseStudy: item }
  }));
}

const { caseStudy } = Astro.props;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://ai.itsmartflex.com').replace(/\/$/, '');
const canonicalURL = `${siteUrl}/cases/${caseStudy.slug}/`;
---

<Layout 
  title={`${caseStudy.title.uk} | IT SmartFlex AI Hub`} 
  description={caseStudy.overview.uk} 
  image={caseStudy.bannerImage} 
  type="article"
>
  <div id="case-study-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 space-y-8 sm:space-y-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex flex-wrap items-center text-xs text-[#515151] gap-1.5 sm:gap-2 font-roboto no-print">
      <a href="/" class="hover:text-brand-red font-medium">Головна</a>
      <span>/</span>
      <a href="/cases/" class="hover:text-brand-red font-medium">Case Studies</a>
      <span>/</span>
      <span class="text-text-main font-semibold truncate max-w-xs">{caseStudy.title.uk}</span>
    </nav>

    <!-- Main Grid Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Left Column: Case Meta, Title, Business Tasks & Share Toolbar -->
      <div class="lg:col-span-5 space-y-6 sm:space-y-8">
        
        <div>
          <FigmaStatusBadge variant="business">
            {caseStudy.badge.uk}
          </FigmaStatusBadge>
        </div>

        <div class="space-y-2">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-fixel font-extrabold text-text-main leading-tight tracking-tight">
            {caseStudy.title.uk}
          </h1>

          <p class="text-base sm:text-lg text-text-muted font-roboto leading-relaxed">
            {caseStudy.subtitle.uk}
          </p>
        </div>

        <!-- Section: Бізнес задача -->
        <div class="space-y-3 pt-2">
          <h3 class="text-base sm:text-lg font-fixel font-bold text-brand-red-dark">
            Бізнес задача:
          </h3>

          <div class="flex flex-wrap gap-2">
            {caseStudy.tags.map(tag => (
              <span class="px-3.5 sm:px-4 py-1.5 sm:py-2 bg-white border border-gray-300 text-text-main text-[11px] sm:text-xs font-semibold rounded-full shadow-sm font-roboto">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Section: Сфера застосування -->
        <div class="space-y-3 pt-2">
          <h3 class="text-base sm:text-lg font-fixel font-bold text-brand-red-dark">
            Сфера застосування:
          </h3>

          <p class="text-sm text-text-main font-semibold leading-relaxed font-roboto">
            {caseStudy.scope.uk}
          </p>
        </div>

        <!-- Complexity Comparison Box -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white border border-gray-100 shadow-sm space-y-3">
          <h4 class="text-xs font-bold text-text-muted uppercase tracking-wider">Складність впровадження</h4>
          <div class="grid grid-cols-2 gap-3 text-xs sm:text-sm font-roboto">
            <div class="p-3 rounded-xl bg-gray-50 border border-gray-200">
              <span class="text-gray-500 block text-[11px]">Без ШІ</span>
              <span class="font-bold text-rose-600">{caseStudy.difficultyWithout.uk}</span>
            </div>
            <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
              <span class="text-emerald-700 block text-[11px]">З ШІ</span>
              <span class="font-bold text-emerald-800">{caseStudy.difficultyWith.uk}</span>
            </div>
          </div>
        </div>

        <!-- Share Action Toolbar (Centered Circular Red Outline Buttons, No Title/Labels) -->
        <div class="p-4 rounded-2xl bg-white border border-gray-100 shadow-card flex flex-col items-center justify-center gap-2.5 no-print">
          <div class="flex items-center justify-center gap-5 sm:gap-6">
            <!-- 1. PDF Download Button (Red Circle) -->
            <button 
              id="share-pdf-btn"
              type="button" 
              title="Скачати PDF"
              aria-label="Скачати PDF"
              class="w-12 h-12 rounded-full border-2 border-brand-red bg-white hover:bg-brand-red hover:text-white text-brand-red shadow-sm flex items-center justify-center hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer group"
            >
              <svg class="w-6 h-6 transition-colors duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 8v11a2 2 0 002 2h11" stroke-linecap="round"/>
                <rect x="7" y="3" width="13" height="15" rx="2" stroke-width="1.8"/>
                <text x="13.5" y="13.5" text-anchor="middle" font-size="6" font-weight="900" fill="currentColor" stroke="none" font-family="sans-serif">PDF</text>
              </svg>
            </button>

            <!-- 2. Copy Link Button (Red Circle) -->
            <button 
              id="share-copy-btn"
              type="button" 
              title="Скопіювати посилання"
              aria-label="Скопіювати посилання"
              class="w-12 h-12 rounded-full border-2 border-brand-red bg-white hover:bg-brand-red hover:text-white text-brand-red shadow-sm flex items-center justify-center hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer group"
            >
              <svg class="w-6 h-6 transition-colors duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                <rect x="7" y="7" width="13" height="13" rx="2"/>
              </svg>
            </button>

            <!-- 3. LinkedIn Button (Red Circle) -->
            <a 
              id="share-linkedin-btn"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`}
              target="_blank"
              rel="noopener noreferrer"
              title="Поділитись в LinkedIn"
              aria-label="Поділитись в LinkedIn"
              class="w-12 h-12 rounded-full border-2 border-brand-red bg-white hover:bg-brand-red hover:text-white text-brand-red shadow-sm flex items-center justify-center hover:scale-105 active:scale-95 transition-all duration-200 group"
            >
              <svg class="w-6 h-6 fill-current transition-colors duration-200" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.6a1.49 1.49 0 0 0-1.49 1.49c0 .82.67 1.49 1.49 1.49a1.49 1.49 0 0 0 1.49-1.49c0-.82-.67-1.49-1.49-1.49Z"/>
              </svg>
            </a>
          </div>

          <!-- Subtle Toast Notification (Shows briefly when copying) -->
          <div id="share-copy-toast" class="hidden text-xs text-emerald-600 font-semibold pt-0.5 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Посилання скопійовано в буфер обміну!</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Banner & Detailed Solution Cards -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8">
        
        <!-- Banner Image -->
        <div class="rounded-[24px] sm:rounded-[32px] overflow-hidden border border-gray-100 shadow-card bg-surface-variant relative aspect-[16/9] group">
          <img 
            src={caseStudy.bannerImage} 
            alt={caseStudy.title.uk}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
          />
        </div>

        <!-- Top Card: Огляд рішення -->
        <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-8 border border-gray-100 shadow-card space-y-4">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-brand-red"></div>
            <h3 class="text-lg sm:text-xl font-fixel font-bold text-text-main">
              Огляд рішення
            </h3>
          </div>

          <p class="text-sm sm:text-base text-text-muted leading-relaxed font-roboto">
            {caseStudy.overview.uk}
          </p>
        </div>

        <!-- Bottom Card: 2x2 Grid -->
        <div class="bg-white rounded-[24px] sm:rounded-[32px] p-6 sm:p-8 border border-gray-100 shadow-card grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
          
          <!-- Item 1: Бізнес виклик -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Бізнес виклик:
            </h4>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
              {caseStudy.challenge.uk}
            </p>
          </div>

          <!-- Item 2: Рішення -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Рішення:
            </h4>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
              {caseStudy.solution.uk}
            </p>
          </div>

          <!-- Item 3: Цінність для бізнесу -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Цінність для бізнесу:
            </h4>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-roboto">
              {caseStudy.metrics.map(m => `${m.label.uk}: ${m.value}`).join('. ')}
            </p>
          </div>

          <!-- Item 4: Технологічний стек -->
          <div class="space-y-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-brand-red-soft text-brand-red flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h4 class="text-sm sm:text-base font-fixel font-bold text-text-main">
              Технологічний стек:
            </h4>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {caseStudy.techStack.map(t => (
                <span class="px-2.5 py-1 bg-gray-100 text-text-main rounded-md text-[11px] font-mono font-semibold">
                  {t}
                </span>
              ))}
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <script 
    is:inline 
    data-slug={caseStudy.slug} 
    data-title={caseStudy.title.uk} 
    data-subtitle={caseStudy.subtitle.uk}
    data-badge={caseStudy.badge.uk}
    data-overview={caseStudy.overview.uk}
    data-challenge={caseStudy.challenge.uk}
    data-solution={caseStudy.solution.uk}
    data-metrics={caseStudy.metrics.map(m => `${m.label.uk}: ${m.value}`).join('. ')}
    data-tech={caseStudy.techStack.join(', ')}
    data-image={caseStudy.bannerImage}
    data-type={caseStudy.type} 
    data-canonical={canonicalURL}
    data-site={siteUrl}
  >
    (function() {
      var scriptEl = document.currentScript;
      if (!scriptEl) return;

      var slug = scriptEl.getAttribute('data-slug');
      var title = scriptEl.getAttribute('data-title');
      var subtitle = scriptEl.getAttribute('data-subtitle');
      var badge = scriptEl.getAttribute('data-badge');
      var overview = scriptEl.getAttribute('data-overview');
      var challenge = scriptEl.getAttribute('data-challenge');
      var solution = scriptEl.getAttribute('data-solution');
      var metrics = scriptEl.getAttribute('data-metrics');
      var tech = scriptEl.getAttribute('data-tech');
      var image = scriptEl.getAttribute('data-image');
      var type = scriptEl.getAttribute('data-type');
      var canonical = scriptEl.getAttribute('data-canonical');
      var site = scriptEl.getAttribute('data-site');

      if (typeof window.sendAmplitudeEvent === 'function') {
        window.sendAmplitudeEvent('view_case_detail', { slug: slug, title: title, type: type });
      }

      // 1. Copy Link Handler
      var copyBtn = document.getElementById('share-copy-btn');
      var toast = document.getElementById('share-copy-toast');
      if (copyBtn) {
        copyBtn.onclick = function() {
          var targetUrl = canonical || window.location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(targetUrl);
          } else {
            var tempInput = document.createElement('input');
            tempInput.value = targetUrl;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
          }
          if (toast) {
            toast.classList.remove('hidden');
            setTimeout(function() { toast.classList.add('hidden'); }, 3000);
          }
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('share_copy_link', { slug: slug, title: title });
          }
        };
      }

      // 2. LinkedIn Share Handler
      var linkedinBtn = document.getElementById('share-linkedin-btn');
      if (linkedinBtn) {
        var pageUrl = encodeURIComponent(canonical || window.location.href);
        linkedinBtn.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + pageUrl;
        linkedinBtn.onclick = function() {
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('share_linkedin', { slug: slug, title: title });
          }
        };
      }

      // 3. Perfect Ukrainian Cyrillic A4 PDF Generator via html2pdf.js
      var pdfBtn = document.getElementById('share-pdf-btn');
      if (pdfBtn) {
        pdfBtn.onclick = function() {
          if (typeof window.sendAmplitudeEvent === 'function') {
            window.sendAmplitudeEvent('share_download_pdf', { slug: slug, title: title });
          }

          pdfBtn.setAttribute('disabled', 'true');
          pdfBtn.style.opacity = '0.5';

          function generateFullUkrainianPDF() {
            var pdfDiv = document.createElement('div');
            pdfDiv.id = 'pdf-download-container';
            pdfDiv.style.position = 'absolute';
            pdfDiv.style.top = '0';
            pdfDiv.style.left = '0';
            pdfDiv.style.width = '790px';
            pdfDiv.style.zIndex = '999999';
            pdfDiv.style.background = '#ffffff';
            pdfDiv.style.color = '#111827';
            pdfDiv.style.padding = '36px';
            pdfDiv.style.boxSizing = 'border-box';
            pdfDiv.style.fontFamily = "'Roboto', 'Inter', system-ui, -apple-system, sans-serif";

            var fullImgUrl = image.startsWith('http') ? image : (window.location.origin + (image.startsWith('/') ? '' : '/') + image);

            pdfDiv.innerHTML = 
              '<div style="border-bottom: 2px solid #e30613; padding-bottom: 14px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">' +
                '<div style="font-size: 20px; font-weight: 800; color: #e30613;">IT SmartFlex AI Hub</div>' +
                '<div style="font-size: 12px; color: #6b7280; font-weight: 600;">Кейс-стаді</div>' +
              '</div>' +

              '<div style="margin-bottom: 20px;">' +
                '<div style="display: inline-block; padding: 4px 14px; background: #fee2e2; color: #991b1b; font-size: 11px; font-weight: 700; border-radius: 9999px; margin-bottom: 12px;">' + badge + '</div>' +
                '<h1 style="font-size: 24px; font-weight: 800; color: #111827; margin: 0 0 10px 0; line-height: 1.3;">' + title + '</h1>' +
                '<p style="font-size: 14px; color: #4b5563; margin: 0; line-height: 1.6;">' + subtitle + '</p>' +
              '</div>' +

              '<div style="margin-bottom: 24px; border-radius: 16px; overflow: hidden; border: 1px solid #e5e7eb;">' +
                '<img src="' + fullImgUrl + '" style="width: 100%; height: 260px; object-fit: cover; display: block;" />' +
              '</div>' +

              '<div style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 14px; padding: 20px; margin-bottom: 24px;">' +
                '<div style="font-size: 14px; font-weight: 700; color: #e30613; margin-bottom: 8px;">Огляд рішення:</div>' +
                '<div style="font-size: 13px; color: #374151; line-height: 1.6;">' + overview + '</div>' +
              '</div>' +

              '<table style="width: 100%; border-collapse: separate; border-spacing: 14px; margin-left: -14px; margin-right: -14px; margin-bottom: 20px;">' +
                '<tr>' +
                  '<td style="width: 50%; vertical-align: top; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px;">' +
                    '<div style="font-size: 13px; font-weight: 700; color: #111827; margin-bottom: 6px;">⚡ Бізнес виклик:</div>' +
                    '<div style="font-size: 12px; color: #4b5563; line-height: 1.5;">' + challenge + '</div>' +
                  '</td>' +
                  '<td style="width: 50%; vertical-align: top; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px;">' +
                    '<div style="font-size: 13px; font-weight: 700; color: #111827; margin-bottom: 6px;">🎯 Рішення:</div>' +
                    '<div style="font-size: 12px; color: #4b5563; line-height: 1.5;">' + solution + '</div>' +
                  '</td>' +
                '</tr>' +
                '<tr>' +
                  '<td style="width: 50%; vertical-align: top; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px;">' +
                    '<div style="font-size: 13px; font-weight: 700; color: #111827; margin-bottom: 6px;">📊 Цінність для бізнесу:</div>' +
                    '<div style="font-size: 12px; color: #4b5563; line-height: 1.5;">' + metrics + '</div>' +
                  '</td>' +
                  '<td style="width: 50%; vertical-align: top; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px;">' +
                    '<div style="font-size: 13px; font-weight: 700; color: #111827; margin-bottom: 6px;">💻 Технологічний стек:</div>' +
                    '<div style="font-size: 12px; color: #4b5563; line-height: 1.5;">' + tech + '</div>' +
                  '</td>' +
                '</tr>' +
              '</table>' +

              '<div style="border-top: 1px solid #e5e7eb; padding-top: 14px; text-align: center; font-size: 11px; color: #9ca3af;">' +
                '© IT SmartFlex | AI Hub — ' + (canonical || site) +
              '</div>';

            document.body.appendChild(pdfDiv);

            setTimeout(function() {
              var opt = {
                margin:       [8, 8, 8, 8],
                filename:     (slug || 'case-study') + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, allowTaint: true, logging: false, width: 790 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
              };

              if (window.html2pdf) {
                window.html2pdf().set(opt).from(pdfDiv).save().then(function() {
                  if (document.body.contains(pdfDiv)) document.body.removeChild(pdfDiv);
                  pdfBtn.removeAttribute('disabled');
                  pdfBtn.style.opacity = '1';
                }).catch(function() {
                  if (document.body.contains(pdfDiv)) document.body.removeChild(pdfDiv);
                  window.print();
                  pdfBtn.removeAttribute('disabled');
                  pdfBtn.style.opacity = '1';
                });
              } else {
                if (document.body.contains(pdfDiv)) document.body.removeChild(pdfDiv);
                window.print();
                pdfBtn.removeAttribute('disabled');
                pdfBtn.style.opacity = '1';
              }
            }, 300);
          }

          if (typeof window.html2pdf === 'undefined') {
            var script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
            script.onload = generateFullUkrainianPDF;
            script.onerror = function() {
              window.print();
              pdfBtn.removeAttribute('disabled');
              pdfBtn.style.opacity = '1';
            };
            document.head.appendChild(script);
          } else {
            generateFullUkrainianPDF();
          }
        };
      }
    })();
  </script>
</Layout>
