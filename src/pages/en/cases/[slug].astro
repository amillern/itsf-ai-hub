---
import Layout from '../../../layouts/Layout.astro';
import CaseDetailSections from '../../../sections/CaseDetailSections.astro';
import { caseStudies } from '../../../data/cases';

export function getStaticPaths() {
  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
---

<Layout 
  title={`${caseStudy.title.en} | IT SmartFlex AI Hub`}
  description={caseStudy.subtitle.en}
  image={caseStudy.bannerImage}
  type="article"
  lang="en"
>
  <CaseDetailSections caseStudy={caseStudy} lang="en" />
</Layout>
