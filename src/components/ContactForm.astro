---
---

<div class="bg-[#11052C] bg-[url('/assets/bg-hero-dark.jpg')] bg-cover bg-center text-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-white/15 shadow-2xl relative overflow-hidden">
  
  <div class="mb-8 space-y-3">
    <h3 class="text-2xl sm:text-3xl font-fixel font-extrabold text-white tracking-tight">Форма зворотного зв'язку</h3>
    <p class="text-gray-300 text-xs sm:text-sm font-roboto leading-relaxed">
      Розкажіть про свою задачу. Ми допоможемо визначити можливості використання AI саме для вашої організації.
    </p>
  </div>

  <form id="contact-form" class="space-y-4 font-roboto">
    
    <!-- Row 1: Name & Surname -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="firstName" class="block text-xs font-medium text-gray-200 mb-1.5">
          Ім'я *
        </label>
        <input 
          type="text" 
          id="firstName" 
          name="firstName" 
          required 
          placeholder="Олександр" 
          class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all"
        />
      </div>

      <div>
        <label for="lastName" class="block text-xs font-medium text-gray-200 mb-1.5">
          Прізвище *
        </label>
        <input 
          type="text" 
          id="lastName" 
          name="lastName" 
          required 
          placeholder="Петренко" 
          class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all"
        />
      </div>
    </div>

    <!-- Row 2: Company & Position -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="company" class="block text-xs font-medium text-gray-200 mb-1.5">
          Компанія *
        </label>
        <input 
          type="text" 
          id="company" 
          name="company" 
          required 
          placeholder="IT SmartFlex" 
          class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all"
        />
      </div>

      <div>
        <label for="position" class="block text-xs font-medium text-gray-200 mb-1.5">
          Посада *
        </label>
        <input 
          type="text" 
          id="position" 
          name="position" 
          required 
          placeholder="CTO / Tech Lead" 
          class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all"
        />
      </div>
    </div>

    <!-- Row 3: Email & Phone -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="email" class="block text-xs font-medium text-gray-200 mb-1.5">
          Email *
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="name@company.com" 
          class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all"
        />
      </div>

      <div>
        <label for="phone" class="block text-xs font-medium text-gray-200 mb-1.5">
          Телефон *
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="+380 (50) 000-00-00" 
          class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all"
        />
      </div>
    </div>

    <!-- Row 4: Short task description textarea -->
    <div>
      <label for="message" class="block text-xs font-medium text-gray-200 mb-1.5">
        Короткий опис задачі
      </label>
      <textarea 
        id="message" 
        name="message" 
        rows="4" 
        required 
        placeholder="Опишіть ваш бізнес-процес або задачу..." 
        class="w-full px-4 py-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition-all resize-none"
      ></textarea>
    </div>

    <!-- Submit Button (Figma Style) -->
    <div class="pt-2">
      <button 
        type="submit" 
        class="w-full sm:w-auto px-8 py-3.5 bg-white text-[#181818] hover:bg-brand-red hover:text-white font-fixel font-bold text-sm sm:text-base rounded-full shadow-lg hover:shadow-xl transition-all duration-300 active:scale-95 flex items-center justify-center gap-2"
      >
        <span>Обговорити задачу</span>
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </div>
  </form>

  <!-- Success Notification -->
  <div id="form-success" class="hidden mt-6 p-4 bg-emerald-500/20 border border-emerald-400/40 text-emerald-200 rounded-xl text-sm font-medium items-center gap-3">
    <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
    <span>Дякуємо! Ваш запит успішно відправлено. Ми зв'яжемося з вами найближчим часом.</span>
  </div>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successMsg) {
      successMsg.classList.remove('hidden');
      successMsg.classList.add('flex');
    }
    if (typeof (window as any).sendAmplitudeEvent === 'function') {
      (window as any).sendAmplitudeEvent('submit_contact_form', {});
    }
    form.reset();
  });
</script>
