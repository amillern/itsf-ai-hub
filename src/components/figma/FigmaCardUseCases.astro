---
import FigmaStatusBadge from './FigmaStatusBadge.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  tags?: string[];
  slug?: string;
  itemData?: any;
}

const {
  title,
  description,
  image = "/assets/cards/support-bot.jpg",
  tags = [],
  slug = "support-bot",
  itemData
} = Astro.props;

const tagsString = Array.isArray(tags) ? tags.join('|||') : '';
---

<a 
  href={`/cases/${slug}/`}
  class="catalog-item-card group bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between"
  data-type="usecase"
  data-tags={tagsString}
>
  <div>
    <!-- Banner Image with Floating Use Case Badge -->
    <div class="relative h-56 bg-surface-variant overflow-hidden p-3 flex items-start">
      <img 
        src={image} 
        alt={title} 
        width="400"
        height="224"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500" 
      />
      
      <div class="absolute top-6 left-6 z-10">
        <FigmaStatusBadge variant="usecase">
          Use Case
        </FigmaStatusBadge>
      </div>
    </div>

    <!-- Content Padding -->
    <div class="p-6 space-y-3">
      <h3 class="text-lg font-fixel font-bold text-text-main group-hover:text-brand-red transition-colors line-clamp-2">
        {title}
      </h3>

      <p class="text-xs text-text-muted font-roboto line-clamp-3 leading-relaxed">
        {description}
      </p>
    </div>
  </div>

  <!-- Tags Footer -->
  <div class="px-6 pb-6 pt-2 border-t border-gray-50 flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="px-3 py-1 bg-surface text-text-muted text-[11px] font-medium rounded-full font-roboto">
        {tag}
      </span>
    ))}
  </div>
</a>
