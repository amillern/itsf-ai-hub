---
interface Props {
  variant?: 'primary' | 'maroon' | 'white' | 'secondary' | 'text';
  iconLeft?: string;
  iconRight?: string;
  href?: string;
  class?: string;
  id?: string;
  type?: 'button' | 'submit';
}

const {
  variant = 'primary',
  iconLeft,
  iconRight,
  href,
  class: className = '',
  id,
  type = 'button'
} = Astro.props;

const variantStyles = {
  primary: 'bg-brand-red text-white hover:bg-brand-red-dark shadow-sm',
  maroon: 'bg-brand-red-maroon text-white hover:bg-brand-red-dark shadow-sm',
  white: 'bg-white text-text-main hover:bg-gray-100 shadow-sm border border-gray-100',
  secondary: 'bg-surface-variant text-text-main hover:bg-gray-200 border border-surface-border',
  text: 'bg-transparent text-brand-red hover:bg-brand-red/5',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  id={id}
  href={href}
  type={href ? undefined : type}
  class:list={[
    "inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-sm font-fixel font-semibold transition-all duration-200 active:scale-95",
    variantStyles[variant],
    className
  ]}
>
  {iconLeft && (
    <span class="w-4 h-4 flex items-center justify-center">
      <Fragment set:html={iconLeft} />
    </span>
  )}
  <slot />
  {iconRight && (
    <span class="w-4 h-4 flex items-center justify-center">
      <Fragment set:html={iconRight} />
    </span>
  )}
</Tag>
