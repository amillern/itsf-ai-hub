---
import { siteConfig } from '../data/siteConfig';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/' || href === '') {
    return currentPath === '/' || currentPath === '';
  }
  const cleanCurrent = currentPath.replace(/\/$/, '');
  const cleanHref = href.replace(/\/$/, '');
  return cleanCurrent === cleanHref || cleanCurrent.startsWith(cleanHref + '/');
}
---

<!-- Non-fixed header (compact relative header) -->
<header class="relative z-50 py-2.5 sm:py-4 px-4 sm:px-12 transition-all w-full max-w-full">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 sm:gap-8">
    
    <!-- Prominent Unclipped Brand Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0 py-1 overflow-visible">
      <img 
        src="/assets/logo.svg" 
        alt="smartflex x AI Hub" 
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-7 sm:h-9 lg:h-10 w-auto max-w-full object-contain transition-transform group-hover:scale-105" 
      />
    </a>

    <!-- Compact Desktop Capsule Navigation Bar -->
    <nav class="hidden md:flex items-center bg-white/95 backdrop-blur-md p-1 sm:p-1.5 rounded-full border border-gray-200/80 shadow-sm space-x-1 sm:space-x-1.5">
      {siteConfig.nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "px-5 lg:px-6 py-2 lg:py-2.5 text-xs lg:text-sm font-semibold font-fixel rounded-full transition-all duration-200",
              active 
                ? "bg-brand-red text-white shadow-sm font-bold" 
                : "text-text-main hover:bg-gray-100/90"
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Mobile Capsule Burger Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="flex md:hidden items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-gray-200 shadow-sm text-text-main shrink-0 cursor-pointer transition-all active:scale-95 z-50"
      aria-label="Переключити меню"
    >
      <svg class="w-5 h-5 text-text-main" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon-open" class="inline-flex" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 7h16M4 12h16M4 17h16" />
        <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden mt-3 bg-white/95 backdrop-blur-md rounded-3xl p-4 shadow-popup border border-gray-100 space-y-2">
    {siteConfig.nav.map((item) => {
      const active = isActive(item.href);
      return (
        <a
          href={item.href}
          class:list={[
            "block px-6 py-3 text-sm sm:text-base font-semibold rounded-2xl transition-colors",
            active 
              ? "bg-brand-red text-white font-bold" 
              : "text-text-main hover:bg-gray-100"
          ]}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</header>

<script is:inline>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!toggleBtn || !menu) return;

    toggleBtn.onclick = function(e) {
      e.stopPropagation();
      const isHidden = menu.classList.toggle('hidden');
      if (iconOpen) iconOpen.classList.toggle('hidden', !isHidden);
      if (iconClose) iconClose.classList.toggle('hidden', isHidden);
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
</script>
