---
---

<div 
  id="cookie-consent-banner" 
  class="hidden fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 bg-[#181818]/95 backdrop-blur-xl border border-white/20 rounded-2xl p-5 shadow-2xl text-white transition-all duration-300"
>
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="text-xl">🍪</span>
        <h4 class="text-sm font-fixel font-bold text-white">Cookie та конфіденційність</h4>
      </div>
      <button 
        id="cookie-close-btn" 
        class="text-gray-400 hover:text-white text-xs p-1 rounded-md hover:bg-white/10 transition-colors"
        aria-label="Закрити"
      >
        ✕
      </button>
    </div>

    <p class="text-xs text-gray-300 font-roboto leading-relaxed">
      Ми використовуємо аналітичні файли cookie для покращення вашого досвіду користування сайтом відповідно до GDPR та Законодавства України.
    </p>

    <div class="flex items-center justify-between gap-2 pt-2">
      <a 
        href="/privacy/" 
        class="text-xs text-purple-300 hover:text-white underline font-roboto transition-colors"
      >
        Політика
      </a>

      <div class="flex items-center gap-2">
        <button 
          id="cookie-reject-btn" 
          class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white text-xs font-bold font-fixel rounded-full transition-all active:scale-95 cursor-pointer"
        >
          Відхилити
        </button>

        <button 
          id="cookie-accept-btn" 
          class="px-4 py-2 bg-brand-red hover:bg-brand-red-dark text-white text-xs font-bold font-fixel rounded-full shadow-md hover:shadow-lg transition-all active:scale-95 cursor-pointer"
        >
          Прийняти всі
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function checkAndShowConsent() {
      const banner = document.getElementById('cookie-consent-banner');
      const acceptBtn = document.getElementById('cookie-accept-btn');
      const rejectBtn = document.getElementById('cookie-reject-btn');
      const closeBtn = document.getElementById('cookie-close-btn');

      if (!banner) return;

      let consent = null;
      try {
        consent = localStorage.getItem('ai_hub_cookie_consent');
      } catch (e) {}

      function hideBanner() {
        banner.classList.add('hidden');
        banner.style.display = 'none';
      }

      function showBanner() {
        banner.classList.remove('hidden');
        banner.style.display = 'block';
      }

      if (!consent) {
        showBanner();
      } else if (consent === 'granted') {
        hideBanner();
        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            'analytics_storage': 'granted'
          });
        }
      } else {
        hideBanner();
      }

      if (acceptBtn) {
        acceptBtn.onclick = function(e) {
          e.preventDefault();
          try {
            localStorage.setItem('ai_hub_cookie_consent', 'granted');
          } catch(err) {}

          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              'analytics_storage': 'granted'
            });
          }
          hideBanner();
        };
      }

      if (rejectBtn) {
        rejectBtn.onclick = function(e) {
          e.preventDefault();
          try {
            localStorage.setItem('ai_hub_cookie_consent', 'denied');
          } catch(err) {}

          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              'analytics_storage': 'denied'
            });
          }
          hideBanner();
        };
      }

      if (closeBtn) {
        closeBtn.onclick = function(e) {
          e.preventDefault();
          try {
            localStorage.setItem('ai_hub_cookie_consent', 'denied');
          } catch(err) {}
          hideBanner();
        };
      }

      window.revokeCookieConsent = function() {
        try {
          localStorage.removeItem('ai_hub_cookie_consent');
        } catch(e) {}
        showBanner();
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', checkAndShowConsent);
    } else {
      checkAndShowConsent();
    }
  })();
</script>
