---
import Badge from './Badge.astro';
import type { Solution } from '../data/solutions';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---

<div class="group bg-white rounded-3xl p-6 sm:p-8 border border-surface-border shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
  <!-- Accent top border gradient on hover -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-red to-rose-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <div>
    <!-- Category Badge & Metric -->
    <div class="flex items-center justify-between gap-3 mb-5">
      <Badge type={solution.badgeType}>
        {solution.categoryLabel}
      </Badge>

      {solution.metrics && (
        <span class="text-xs font-semibold text-brand-red bg-brand-red/5 px-2.5 py-1 rounded-md border border-brand-red/10">
          {solution.metrics}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl font-fixel font-bold text-text-main group-hover:text-brand-red transition-colors duration-200 mb-3 leading-snug">
      {solution.title}
    </h3>

    <!-- Description -->
    <p class="text-text-muted text-sm leading-relaxed mb-6">
      {solution.shortDesc}
    </p>
  </div>

  <div>
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {solution.tags.map(tag => (
        <span class="text-[11px] font-medium text-gray-600 bg-surface-variant px-2.5 py-1 rounded-lg">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Action Link -->
    <a 
      href={`/cases#${solution.id}`} 
      class="inline-flex items-center text-sm font-semibold text-brand-red hover:text-brand-red-dark group-hover:translate-x-1 transition-all duration-200"
    >
      <span>Детальніше про рішення</span>
      <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>
