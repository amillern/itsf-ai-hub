---
import Badge from './Badge.astro';
import type { CaseStudy } from '../data/cases';
import type { Lang } from '../i18n';
import { useTranslations } from '../i18n';

interface Props {
  caseStudy: CaseStudy;
  lang?: Lang;
}

const { caseStudy, lang = 'uk' } = Astro.props;
const t = useTranslations(lang);
const caseUrl = lang === 'en' ? `/en/cases/${caseStudy.slug}/` : `/cases/${caseStudy.slug}/`;
---

<div class="group bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-3 mb-2">
      <Badge type="red">
        {caseStudy.badge[lang]}
      </Badge>
    </div>

    <h3 class="text-xl font-fixel font-bold text-text-main group-hover:text-brand-red transition-colors duration-200 leading-snug">
      {caseStudy.title[lang]}
    </h3>

    <p class="text-text-muted text-sm leading-relaxed font-roboto">
      {caseStudy.overview[lang]}
    </p>
  </div>

  <div class="pt-4 border-t border-gray-100 mt-6">
    <div class="flex flex-wrap gap-1.5 mb-4">
      {caseStudy.tags[lang].map((tag: string) => (
        <span class="text-[11px] font-medium text-gray-600 bg-gray-100 px-2.5 py-1 rounded-lg">
          #{tag}
        </span>
      ))}
    </div>

    <a 
      href={caseUrl} 
      class="inline-flex items-center text-sm font-semibold text-brand-red hover:text-brand-red-dark group-hover:translate-x-1 transition-all duration-200"
    >
      <span>{t('cases.card.readmore')}</span>
      <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</div>
