---
---

<footer class="mt-auto bg-[#161616] text-white py-10 sm:py-14 px-4 sm:px-12 transition-all border-t border-white/10 font-roboto">
  <div class="max-w-7xl mx-auto space-y-8">
    
    <!-- Top Row: Bright White Logo & Nav Links -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <img 
          src="/assets/Logo_AI_HUB_L_white.svg" 
          alt="smartflex x AI Hub" 
          width="216" 
          height="52" 
          loading="lazy" 
          decoding="async" 
          class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105" 
        />
      </a>

      <nav class="flex items-center gap-6 text-sm font-semibold text-gray-300 font-fixel">
        <a href="/" class="hover:text-white transition-colors">Головна</a>
        <a href="/catalog/" class="hover:text-white transition-colors">AI-рішення</a>
        <a href="/contacts/" class="hover:text-white transition-colors">Контакти</a>
        <a id="footer-main-site-btn" href="https://itsmartflex.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Головний сайт</a>
      </nav>
    </div>

    <!-- Divider 1 -->
    <div class="border-t border-white/10 w-full"></div>

    <!-- Middle Row: Descriptive Paragraphs & Round White Social Buttons -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-9 space-y-3 text-xs sm:text-sm text-gray-400 font-roboto leading-relaxed">
        <p>
          AI Hub IT SmartFlex - центр практичного застосування штучного інтелекту на основі досвіду компанії. AI Hub є частиною цифрової екосистеми IT SmartFlex та демонструє практичний досвід компанії у сфері штучного інтелекту.
        </p>
        <p class="text-gray-500 text-xs">
          Матеріали сайту мають інформаційний характер і демонструють приклади та сценарії застосування технологій штучного інтелекту.
        </p>
      </div>

      <div class="lg:col-span-3 flex items-center justify-start lg:justify-end gap-3.5">
        <!-- Email Icon Button -->
        <a
          id="footer-email-btn"
          href="mailto:contact_us@itsmartflex.com"
          title="Написати нам на пошту"
          class="w-11 h-11 rounded-full bg-white text-[#161616] shadow-md flex items-center justify-center hover:bg-gray-200 hover:scale-105 transition-all"
        >
          <svg class="w-5 h-5 text-[#161616]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

        <!-- LinkedIn Icon Button -->
        <a
          id="footer-linkedin-btn"
          href="https://www.linkedin.com/company/it-smartflex"
          target="_blank"
          rel="noopener noreferrer"
          title="LinkedIn"
          class="w-11 h-11 rounded-full bg-white text-[#161616] shadow-md flex items-center justify-center hover:bg-gray-200 hover:scale-105 transition-all"
        >
          <svg class="w-5 h-5 fill-current text-[#161616]" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.6a1.49 1.49 0 0 0-1.49 1.49c0 .82.67 1.49 1.49 1.49a1.49 1.49 0 0 0 1.49-1.49c0-.82-.67-1.49-1.49-1.49Z" />
          </svg>
        </a>

        <!-- Instagram Icon Button -->
        <a
          id="footer-instagram-btn"
          href="https://www.instagram.com/itsmartflex"
          target="_blank"
          rel="noopener noreferrer"
          title="Instagram"
          class="w-11 h-11 rounded-full bg-white text-[#161616] shadow-md flex items-center justify-center hover:bg-gray-200 hover:scale-105 transition-all"
        >
          <svg class="w-5 h-5 fill-none stroke-current text-[#161616]" stroke-width="2" viewBox="0 0 24 24">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      </div>

    </div>

    <!-- Divider 2 -->
    <div class="border-t border-white/10 w-full"></div>

    <!-- Bottom Row: Copyright & Privacy Link -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400 font-roboto">
      <p>© 2026 IT SmartFlex. Всі права захищені.</p>
      <div class="flex flex-wrap items-center gap-4">
        <button type="button" onclick="if(typeof window.revokeCookieConsent === 'function'){ window.revokeCookieConsent(); }" class="hover:text-gray-200 transition-colors underline cursor-pointer">Налаштування cookie</button>
        <a href="/cookies/" class="hover:text-gray-200 transition-colors underline">Політика використання cookies</a>
        <a href="/privacy/" class="hover:text-gray-200 transition-colors underline">Політика конфіденційності</a>
      </div>
    </div>

  </div>

  <script is:inline>
    (function() {
      function trackClick(id, eventName, props) {
        var el = document.getElementById(id);
        if (el) {
          el.addEventListener('click', function() {
            if (typeof window.sendAmplitudeEvent === 'function') {
              window.sendAmplitudeEvent(eventName, props || {});
            }
          });
        }
      }

      trackClick('footer-main-site-btn', 'click_main_site_link', { source: 'footer' });
      trackClick('footer-email-btn', 'click_footer_social', { type: 'email' });
      trackClick('footer-linkedin-btn', 'click_footer_social', { type: 'linkedin' });
      trackClick('footer-instagram-btn', 'click_footer_social', { type: 'instagram' });
    })();
  </script>
</footer>
